{
  "name": "rotta",
  "version": "0.1.0",
  "private": true,
  "description": "Rotta — plataforma SaaS de gestao inteligente para transporte escolar.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@rotta/web",
    "dev:admin": "turbo run dev --filter=@rotta/admin",
    "dev:mobile": "turbo run dev --filter=@rotta/mobile",
    "dev:api": "turbo run dev --filter=@rotta/api",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,yml,yaml}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,yml,yaml}\" --cache",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky || exit 0",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5",
      "multer": "^2.1.1",
      "handlebars": "^4.7.9",
      "tar": "^7.5.22",
      "@expo/cli>tar": "^6.2.1",
      "lodash": "^4.18.1",
      "@xmldom/xmldom@0.9": "^0.9.12",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "nanoid@3": "^3.3.19",
      "postcss@8": "^8.5.28",
      "fast-uri@3": "^3.1.6",
      "picomatch@4": "^4.0.7",
      "glob@10": "^10.5.0",
      "tmp": "^0.2.7",
      "sharp": "^0.35.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-23hp-3jrh-7fpw",
        "GHSA-34x7-hfp2-rc4v",
        "GHSA-83g3-92jg-28cx",
        "GHSA-8qq5-rm4j-mr97",
        "GHSA-8x88-c5mf-7j5w",
        "GHSA-9ppj-qmqm-q256",
        "GHSA-qffp-2rhf-9h96",
        "GHSA-r292-9mhp-454m",
        "GHSA-r6q2-hw4h-h46w",
        "GHSA-27p8-2357-5qqv",
        "GHSA-2v35-w6hq-6mfw",
        "GHSA-4w3w-2rp5-g8jm",
        "GHSA-8344-3jmq-59r6",
        "GHSA-93r5-fhx6-vmg9",
        "GHSA-965w-775f-mr7g",
        "GHSA-c7q8-3ch8-vqpv",
        "GHSA-f6ww-3ggp-fr8h",
        "GHSA-j759-j44w-7fr8",
        "GHSA-w2rr-34g9-rvrj",
        "GHSA-wh4c-j3r5-mjhp",
        "GHSA-x4fp-j954-r2f4",
        "GHSA-x6wf-f3px-wcqx",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-7pqw-9j4j-h8q3",
        "GHSA-jmr9-qjv8-65gv",
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@lhci/cli": "^0.15.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
