# ==============================================================================
# Variaveis de ambiente compartilhadas (usadas pelo docker-compose.yml e por
# mais de um app do monorepo). Cada app tambem possui seu proprio
# `.env.example` com as variaveis especificas dele (Dossie 23, Secao 8).
#
# NUNCA commitar um `.env` real. Este arquivo documenta apenas quais
# variaveis existem — nenhum valor aqui e um segredo real.
# ==============================================================================

# --- Infraestrutura local (docker-compose) ---
POSTGRES_USER=rotta
POSTGRES_PASSWORD=rotta_dev_only
POSTGRES_DB=rotta_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

# --- Banco de dados (consumido por apps/api, apps/worker, apps/realtime-gateway) ---
DATABASE_URL="postgresql://rotta:rotta_dev_only@localhost:5432/rotta_dev?schema=public"
# Conexao DIRETA (sem pooler) — só o CLI do Prisma usa (Dossie 31,
# Postgres na Supabase). Em dev local, igual a DATABASE_URL.
DIRECT_URL="postgresql://rotta:rotta_dev_only@localhost:5432/rotta_dev?schema=public"

# --- Cache / Filas (Redis, consumido por apps/api, apps/worker, apps/realtime-gateway) ---
REDIS_URL="redis://localhost:6379"

# --- Node ---
NODE_ENV="development"
