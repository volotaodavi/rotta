# Ver Dossie 23, Secao 8 (organizacao de variaveis de ambiente) e
# Dossie 12, Secao 12.4 — a aplicacao FALHA AO INICIAR se uma variavel
# obrigatoria estiver ausente ou malformada (ver src/config/env.validation.ts).
# Nenhum valor aqui e um segredo real.

# --- Aplicacao ---
NODE_ENV="development"
PORT=3333
API_PREFIX="v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Opcional — complementa CORS_ORIGINS para origens que mudam a cada
# deploy (Preview Deployments da Vercel, um subdominio novo por PR).
# Ex.: CORS_ORIGIN_REGEX="^https://rotta-(web|admin)-.*-rottabr\.vercel\.app$"
CORS_ORIGIN_REGEX=""

# --- Banco de dados (Dossie 8, Secao 22 — PostgreSQL + PostGIS) ---
DATABASE_URL="postgresql://rotta:rotta_dev_only@localhost:5432/rotta_dev?schema=public"
# Conexao DIRETA (sem pooler) — exigida só pelo CLI do Prisma
# (`migrate deploy`/`migrate dev`), nunca pela aplicacao em execucao.
# Na Supabase (Dossie 31): copie a string "Connection pooling" (porta
# 6543, `?pgbouncer=true`) em DATABASE_URL e a string "Direct connection"
# (porta 5432) aqui. Em dev local (sem pooler) e sempre igual a
# DATABASE_URL.
DIRECT_URL="postgresql://rotta:rotta_dev_only@localhost:5432/rotta_dev?schema=public"

# --- Cache (Dossie 12, Secao 8) ---
REDIS_URL="redis://localhost:6379"

# --- Filas (Dossie 14) — QStash (Upstash), motor de filas serverless.
# Sem estas 3 variaveis, `QstashPublisherService` apenas loga um aviso e
# nao publica jobs assincronos (notificacoes/geocodificacao/sync INEP)
# — a aplicacao nunca falha o boot por causa delas (mesmo padrao
# "stub honesto" de FIREBASE_*/WHATSAPP_* abaixo). Token e chaves de
# assinatura ficam em https://console.upstash.com/qstash.
# API_PUBLIC_URL e a URL publica desta implantacao (ex.: a URL do
# proprio deploy Vercel) — o QStash entrega os jobs de volta via HTTP
# POST para "${API_PUBLIC_URL}/${API_PREFIX}/internal/queue/...", entao
# precisa ser alcancavel pela internet, nunca localhost/rede interna.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
API_PUBLIC_URL=""

# --- Autenticacao (Dossie 12, Secao 4) ---
# Par de chaves RS256 — em desenvolvimento local pode ser gerado com:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Uma variavel de ambiente nao suporta quebra de linha real: cole o PEM
# em uma unica linha substituindo cada quebra de linha por `\n` (2
# caracteres literais, barra + "n") — `src/config/auth.config.ts`
# desfaz essa substituicao ao ler a variavel. Ex.:
#   JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEva...\n-----END PRIVATE KEY-----\n"
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"

# MFA/2FA por TOTP do Admin Rotta (Dossie 43) — chave AES-256 (32 bytes)
# em base64, usada por SecretCipherService para cifrar o segredo TOTP em
# repouso. Gerar com: openssl rand -base64 32
# Sem esta variavel, os endpoints /auth/mfa/* recusam com um erro claro
# (nunca falha o boot da aplicacao) — mas nenhum Admin Rotta consegue
# ativar ou usar MFA, e login de Admin Rotta fica bloqueado no passo de
# setup obrigatorio. Configurar antes do primeiro login de producao.
MFA_ENCRYPTION_KEY=""

# --- Storage (Dossie 9, Secao 2.9 e mensagem do usuario: Supabase Storage) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="rotta-documents"
# Bucket PRIVADO de cima (CNH/documentos, foto de aluno — URL assinada).
# Este é o bucket PÚBLICO (Dossiê 32): só logo/foto de empresa e de
# veículo — nenhum dado pessoal, então getPublicUrl aqui é aceitável.
SUPABASE_STORAGE_PUBLIC_BUCKET="rotta-public"

# --- Rotta Geo Platform (OpenStreetMap: Nominatim + OSRM) ---
# Ao contrario do Mapbox (que este projeto usava antes), nenhuma destas
# e obrigatoria: sem configurar nada, o Rotta Geo Engine (`src/modules/geo`)
# usa as instancias publicas e gratuitas do Nominatim (geocodificacao) e
# do OSRM (rotas) — nenhum token necessario. So sobrescreva para apontar
# a instancias self-hosted (recomendado em producao de escala nacional,
# ja que as instancias publicas tem rate limit/SLA de uso justo).
NOMINATIM_BASE_URL=""
# Identifica a aplicacao nas chamadas ao Nominatim publico — exigido pela
# politica de uso dele (https://operations.osmfoundation.org/policies/nominatim/).
NOMINATIM_USER_AGENT=""
OSRM_BASE_URL=""

# --- Education Sync Agent: sincronizacao automatica do Censo Escolar ---
# Agendamento recorrente via QStash Schedules (coordenado do lado do
# QStash — nao duplica disparo mesmo com varias replicas/regioes do
# apps/api). Com QSTASH_TOKEN + API_PUBLIC_URL configurados (acima),
# a sincronizacao automatica JA fica ativa sozinha, todo dia 1 do mes
# as 4h UTC — INEP_SYNC_CRON so existe pra sobrescrever essa frequencia
# padrao. Sem QSTASH_TOKEN/API_PUBLIC_URL, so manual (POST /geo/inep-sync).
INEP_SYNC_CRON=""
# Ano do Censo Escolar sincronizado automaticamente. Sem INEP_SYNC_ANO,
# usa o ano corrente - 1 (o INEP costuma publicar com um ano de defasagem).
INEP_SYNC_ANO=""

# --- Rotta Communication Engine: Push Notification (Firebase Cloud Messaging) ---
# Vem da Service Account do projeto Firebase (Console -> Configuracoes do
# projeto -> Contas de servico -> Gerar nova chave privada). Sem as 3,
# a aplicacao sobe normalmente e o canal Push recusa o envio com um erro
# claro em vez de falhar o boot (mesmo padrao do Supabase acima).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Rotta Communication Engine: canal WhatsApp (arquitetura preparada) ---
# Provedor ativo hoje: Meta Cloud API (WhatsApp Business Platform oficial
# da Meta). Sem WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID, a
# aplicacao sobe normalmente e o canal recusa o envio com um erro claro.
WHATSAPP_PROVIDER="meta-cloud-api"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# --- Rotta Communication Engine: canal SMS (arquitetura preparada) ---
# Provedor ativo hoje: Twilio. Sem TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN/
# TWILIO_FROM_NUMBER, a aplicacao sobe normalmente e o canal recusa o
# envio com um erro claro.
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Rotta Communication Engine: canal E-mail (templates HTML) ---
# Provedor ativo hoje: Resend. Sem EMAIL_API_KEY, a aplicacao sobe
# normalmente e o canal recusa o envio com um erro claro.
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="notificacoes@rotta.com.br"
EMAIL_FROM_NAME="Rotta"

# --- Rotta AI: verificacao de identidade via Didit (didit.me) ---
# Cobre CNH/OCR (ID Verification), SELFIE (Passive Liveness) e
# FACE_MATCH (comparacao facial) do modulo Rotta AI. Sem DIDIT_API_KEY,
# a aplicacao sobe normalmente e RottaAiService.validateDocument recusa
# a chamada com um erro claro. Pegue a chave em
# https://business.didit.me -> Applications -> (sua aplicacao) -> API Key.
DIDIT_API_KEY=""
DIDIT_BASE_URL="https://verification.didit.me"
# Segredo do destino de webhook cadastrado em Business Console -> API &
# Webhooks -> Add destination (URL: <API_PUBLIC_URL>/v1/webhooks/didit).
# A Didit mostra o "secret_shared_key" uma unica vez, na criacao do
# destino. Sem ele, POST /webhooks/didit recusa toda entrega (401).
DIDIT_WEBHOOK_SECRET=""
# Workflow da sessao hospedada (POST /v3/session/), usada pelo modulo
# IdentityVerification (Motorista/Empresa-Gestor verificando a propria
# identidade). Nao e segredo -- so precisa mudar se um novo workflow
# for publicado no Business Console (Workflows). Vazio usa o workflow
# "Free KYC" ja publicado (default em didit.config.ts).
DIDIT_WORKFLOW_ID=""

# --- Rotta Pay: provedora de pagamento parceira (Lytex, lytex.com.br) ---
# Par OAuth2 client credentials da Lytex (Dossie 26). Sem
# LYTEX_CLIENT_ID/LYTEX_CLIENT_SECRET, RottaPayProviderService recusa o
# saque com um erro claro e a WithdrawalRequest fica aguardando
# processamento manual do Admin Rotta — nunca falha o boot, nunca finge
# uma transferencia. LYTEX_BASE_URL fica sem valor de exemplo aqui de
# proposito: o contrato real da API (endpoints de autenticacao e de
# split de pagamento) ainda nao foi verificado nesta base de codigo —
# ver a nota em src/config/lytex.config.ts.
LYTEX_CLIENT_ID=""
LYTEX_CLIENT_SECRET=""
LYTEX_BASE_URL=""

# --- Rotta Billing: mensalidade da PLATAFORMA via AbacatePay (abacatepay.com) ---
# Isto e' DIFERENTE do Rotta Pay/Lytex acima: aqui e' a Rotta COBRANDO
# R$ 39,90/mes das empresas/transportadoras/autonomos (Dossie 26). O
# Responsavel NUNCA e' cobrado (100% gratuito, sem plano). Sem
# ABACATEPAY_API_KEY, AbacatePayClientService recusa a chamada com um
# erro claro, nunca falha o boot. ABACATEPAY_WEBHOOK_SECRET e' escolhido
# por voce (nao pela AbacatePay) e deve ser colado tambem no campo
# "Secret" do webhook criado no dashboard da AbacatePay.
ABACATEPAY_API_KEY=""
ABACATEPAY_BASE_URL="https://api.abacatepay.com/v2"
ABACATEPAY_WEBHOOK_SECRET=""

# --- Observabilidade (Dossie 12, Secao 10; Dossie 33, rastreamento de erros) ---
LOG_LEVEL="debug"
# Sentry (opcional) — sem ela, erros 500 continuam logados normalmente,
# so sem alerta/agrupamento automatico (ver Dossie 33).
SENTRY_DSN=""
