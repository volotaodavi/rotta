// Schema Prisma da Rotta — Dossie 8 (modelagem de dados) e Dossie 12 (Secao 6).
//
// ESTADO ATUAL: primeiro recorte real do schema, introduzido pelo modulo
// de Empresas (Tenant) — Dossie 8, Secao 3, e Dossie 16 (`EMP-*`). Os
// modelos abaixo cobrem exatamente o que os modulos Empresas/Usuarios/
// Auditoria precisam hoje; os demais 19 dominios do Dossie 13 chegam
// junto com cada modulo real (nunca especulativamente adiantados aqui).
//
// Extensoes previstas quando o primeiro model geoespacial for criado
// (Dossie 8, Secao 22): PostGIS + particionamento declarativo nativo do
// Postgres para a tabela PosicaoGPS. Nao habilitadas ainda.
//
// generator client {
//   provider        = "prisma-client-js"
//   previewFeatures = ["postgresqlExtensions"]
// }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // extensions = [postgis] — habilitado junto com o primeiro model geoespacial (Dossie 8, Secao 16.1)
}

// =============================================================================
// Enums
// =============================================================================

/// Forma societaria da Empresa/Tenant (Dossie 16, `EMP-01`). `AUTONOMO`
/// dispara a regra "o motorista automaticamente e o Administrador da
/// empresa" (Dossie 16, Secao 1.2) — o proprio motorista assina o CPF em
/// `cpfCnpj` e vira o unico `Membership` com papel `empresa`.
enum CompanyType {
  AUTONOMO
  MEI
  LTDA
  SLU
  EIRELI
  OUTRO
}

/// Ciclo de vida comercial da Empresa/Tenant (Dossie 16, `EMP-04`/`EMP-05`).
enum CompanyStatus {
  TRIAL
  ATIVO
  SUSPENSO
  CANCELADO
  INADIMPLENTE
}

/// Status da conta de identidade global `User` — independente de em
/// quantos tenants o usuario tem `Membership` (Dossie 8, Secao 2).
enum UserStatus {
  ATIVO
  INATIVO
}

/// Status do vinculo Usuario<->Empresa<->Papel (Dossie 8, Secao 2 —
/// `VinculoPapel`). Um `Membership` `REMOVIDO` e preservado (nunca
/// apagado) para trilha de auditoria de quem já pertenceu ao tenant.
enum MembershipStatus {
  ATIVO
  SUSPENSO
  REMOVIDO
}

/// Carroceria/porte do veículo (Dossie 13, Secao 9, `VEI-01`).
enum VehicleType {
  AUTOMOVEL
  SEDAN
  SUV
  MINIVAN
  VAN
  MICRO_ONIBUS
  ONIBUS
  OUTRO
}

/// Finalidade de uso do veículo — separado de `VehicleType` (que é a
/// carroceria) porque um mesmo tipo (ex. Van) pode operar tanto
/// transporte escolar quanto fretamento avulso.
enum VehicleCategory {
  ESCOLAR
  FRETAMENTO
  PARTICULAR
  OUTRO
}

/// Ciclo de vida operacional do veículo (`VEI-06`). Transições são
/// sempre explícitas via `VehiclesService` (nunca infere-se
/// `EM_VIAGEM`/`MANUTENCAO` por efeito colateral de outro módulo sem
/// uma chamada própria) — `TripsModule`/`RoutesModule` ainda não
/// existem (ver nota em `Vehicle.viagemAtualId`), então por ora o único
/// disparador real de `EM_VIAGEM` é a própria API (endpoint de status).
enum VehicleStatus {
  DISPONIVEL
  EM_VIAGEM
  MANUTENCAO
  RESERVA
  INATIVO
  BLOQUEADO
}

/// Tipo de documento anexável ao veículo (briefing "DOCUMENTAÇÃO").
enum VehicleDocumentType {
  CRLV
  LICENCIAMENTO
  SEGURO
  LAUDO
  VISTORIA
  FOTO
  OUTRO
}

/// Resultado da análise assíncrona da Rotta AI sobre um
/// `VehicleDocument` (briefing "ROTTA AI"). `INDISPONIVEL` é o valor
/// hoje sempre atribuído — `RottaAiService` é um stub (Dossiê 15) sem
/// provedor de visão computacional/OCR contratado; o upload do
/// documento nunca fica bloqueado esperando por ela.
enum VehicleDocumentAiStatus {
  PENDENTE
  APROVADO
  REPROVADO
  INDISPONIVEL
}

/// Tipo de manutenção (briefing "MANUTENÇÃO").
enum VehicleMaintenanceType {
  TROCA_OLEO
  PNEUS
  FREIOS
  REVISAO
  VISTORIA
  LIMPEZA
  OUTRA
}

/// Tipo de lembrete automático (briefing "LEMBRETES").
enum VehicleReminderType {
  LICENCIAMENTO
  SEGURO
  REVISAO
  TROCA_OLEO
  MANUTENCAO_PREVENTIVA
  VISTORIA
}

/// Estado do lembrete — computado como "vencendo"/"vencido" na camada de
/// aplicação a partir de `dataAlvo` (nunca um job agendado só para
/// isso); este enum guarda apenas o estado que exige ação humana.
enum VehicleReminderStatus {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

/// Papel do vínculo em `VehicleAssignment` (briefing "VINCULAÇÃO").
enum VehicleAssignmentRole {
  MOTORISTA
  MONITOR
}

/// Severidade de uma `VehicleOccurrence` reportada pelo app (briefing
/// "Ocorrências").
enum VehicleOccurrenceSeverity {
  BAIXA
  MEDIA
  ALTA
}

// =============================================================================
// Plan — estrutura extensivel de planos comerciais (Dossie 16, Secao "Plano")
// =============================================================================

/// Catalogo de planos comerciais. Modelado como tabela (nao enum) desde o
/// primeiro plano ("Starter") especificamente para que novos planos sejam
/// uma migration de dado (`INSERT`), nunca uma migration de schema —
/// requisito explicito do briefing ("Criar estrutura para futuros
/// planos"). Populado por `prisma/seed.ts`, nunca por migration manual.
model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  priceCents Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies Company[]

  @@map("plans")
}

// =============================================================================
// Company — o Tenant (Dossie 8, Secao 3 e Dossie 16)
// =============================================================================

/// A Empresa É o tenant (Dossie 8, Secao 1: "toda empresa cadastrada será
/// um tenant independente") — não existe uma tabela `Tenant` separada.
/// `Company.id` é o valor que circula como `tenant_id` em toda tabela de
/// negócio do restante da plataforma (`Membership.companyId`,
/// `CompanySetting.companyId`, `AuditLog.companyId`, e futuramente
/// `Driver.companyId`, `Vehicle.companyId` etc.).
///
/// Configurações operacionais (tema, canais de notificação, integrações)
/// NÃO são colunas aqui — vivem em `CompanySetting` (chave/valor tipado),
/// exatamente pela razão do Dossiê 8, Seção 3.2: esta tabela é lida em
/// praticamente toda requisição autenticada do sistema e deve permanecer
/// enxuta e estável; configurações tendem a crescer em número a cada
/// funcionalidade nova, o que geraria migrations constantes aqui.
model Company {
  id String @id @default(uuid()) @db.Uuid

  razaoSocial  String
  nomeFantasia String
  /// CPF (motorista autônomo) ou CNPJ (demais tipos) — único globalmente,
  /// validado na camada de aplicação (`@rotta/validators`), nunca apenas
  /// no formato (dígito verificador real).
  cpfCnpj      String      @unique
  tipo         CompanyType

  email    String
  telefone String
  whatsapp String?

  cep         String
  endereco    String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  logoUrl     String?
  fotoUrl     String?
  corPrimaria String  @default("#3B6EF6")
  idioma      String  @default("pt-BR")
  fusoHorario String  @default("America/Sao_Paulo")

  status CompanyStatus @default(TRIAL)
  planId String        @db.Uuid
  plan   Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete (Dossie 16, "Excluir Empresa") — nunca DELETE físico.
  /// Distinto de `status = CANCELADO`: cancelamento é uma transição de
  /// ciclo de vida comercial visível/reversível (Admin Rotta reativa);
  /// `deletedAt` é a exclusão administrativa (ex. registro de teste
  /// criado por engano), que sai das listagens por padrão mas preserva a
  /// linha para integridade referencial do histórico de auditoria.
  deletedAt DateTime?

  memberships Membership[]
  settings    CompanySetting[]
  auditLogs   AuditLog[]
  invites     Invite[]
  vehicles    Vehicle[]

  @@index([status])
  @@index([tipo])
  @@index([deletedAt])
  @@map("companies")
}

/// Configuração operacional chave/valor tipada por tenant (Dossie 8,
/// Seção 3.2). `tipo` guarda o tipo lógico do valor serializado em
/// `valor` (`string` | `boolean` | `number` | `json`) — a validação e
/// desserialização tipada acontece na camada de aplicação
/// (`CompanySettingsService`), nunca no banco.
model CompanySetting {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  chave String
  tipo  String
  valor String

  updatedAt DateTime @updatedAt

  @@unique([companyId, chave])
  @@map("company_settings")
}

// =============================================================================
// User — identidade global (Dossie 8, Secao 2)
// =============================================================================

/// Identidade de login, GLOBAL — deliberadamente sem `tenant_id` própria.
/// Um `User` pode ter múltiplos `Membership` em tenants diferentes (ex.:
/// é responsável de um filho na Empresa A e, paralelamente, motorista
/// autônomo cadastrado como Empresa B) — Dossie 8, Seção 2, "VinculoPapel".
/// A autenticação (login/sessão/refresh token) é escopo do módulo Auth
/// (Dossiê 15), ainda não implementado; este módulo modela apenas o
/// suficiente da identidade (incluindo `passwordHash`) para que o
/// cadastro de Empresa possa criar o primeiro usuário administrador sem
/// que o Auth precise remodelar esta tabela depois.
///
/// Campos de autenticação (Dossiê 15, `AUTH-02`/`RN-AUTH-02`) chegam
/// junto com o módulo Auth: `tentativasLoginFalhas`/`bloqueadoAte`
/// implementam o bloqueio progressivo após 5 tentativas malsucedidas em
/// 15 minutos; `consentimentoLgpdAceitoEm` registra o momento da
/// aceitação dos termos no cadastro (LGPD, nunca inferido/assumido).
model User {
  id String @id @default(uuid()) @db.Uuid

  nome         String
  email        String @unique
  telefone     String @unique
  cpf          String @unique
  passwordHash String

  status    UserStatus @default(ATIVO)
  avatarUrl String?

  tentativasLoginFalhas     Int       @default(0)
  bloqueadoAte              DateTime?
  consentimentoLgpdAceitoEm DateTime?

  /// Marca a conta como Administrador Rotta (Dossie 8, Secao 2: "unico
  /// papel sem tenantId, funcionario da Rotta, contas criadas
  /// internamente pela equipe, nunca por self-service") — nao modelado
  /// como uma Company/Membership falsa; o login le esta flag ANTES de
  /// procurar Membership. Nunca setavel por nenhuma rota publica.
  isAdminRotta Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships         Membership[]
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitesCriados      Invite[]             @relation("InviteCriadoPor")
  invitesUsados       Invite[]             @relation("InviteUsadoPor")

  /// Relações do módulo Veículos (Dossiê 13, Secao 9) — um `User` pode
  /// ser referenciado por um `Vehicle`/`VehicleDocument`/etc. de várias
  /// formas distintas (quem enviou o documento vs. quem foi o último
  /// motorista vs. quem registrou uma manutenção), daí os múltiplos
  /// relacionamentos nomeados, mesmo padrão de `InviteCriadoPor`/`InviteUsadoPor`.
  veiculosUltimoMotorista       Vehicle[]            @relation("VehicleUltimoMotorista")
  veiculosUltimoMonitor         Vehicle[]            @relation("VehicleUltimoMonitor")
  documentosVeiculoEnviados     VehicleDocument[]    @relation("VehicleDocumentUploadedBy")
  manutencoesVeiculoRegistradas VehicleMaintenance[] @relation("VehicleMaintenanceRegistradoPor")
  vinculosVeiculo               VehicleAssignment[]  @relation("VehicleAssignmentUser")
  vinculosVeiculoCriados        VehicleAssignment[]  @relation("VehicleAssignmentCriadoPor")
  checklistsVeiculo             VehicleChecklist[]   @relation("VehicleChecklistMotorista")
  ocorrenciasVeiculoReportadas  VehicleOccurrence[]  @relation("VehicleOccurrenceReportadoPor")

  @@map("users")
}

/// `VinculoPapel` do Dossiê 8, Seção 2: liga `User` + `Company` (tenant) +
/// papel (`Role`, `@rotta/types` — valores em `packages/types`/
/// `apps/api/src/shared/enums/role.enum.ts`, nunca redefinidos aqui).
/// Um mesmo par (usuário, empresa) pode ter mais de um papel simultâneo
/// em teoria; a combinação (`userId`, `companyId`, `role`) é única para
/// impedir duplicidade do mesmo vínculo.
model Membership {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Valor de `Role` (Dossie 8, Secao 2) — string, nao enum do Prisma,
  /// para que a fonte unica de verdade continue sendo
  /// `apps/api/src/shared/enums/role.enum.ts` (consumido tambem por
  /// codigo que nao le o schema Prisma, ex. guards).
  role   String
  status MembershipStatus @default(ATIVO)

  convidadoPorId String?   @db.Uuid
  iniciadoEm     DateTime  @default(now())
  encerradoEm    DateTime?

  @@unique([userId, companyId, role])
  @@index([companyId, role, status])
  @@index([userId, status])
  @@map("memberships")
}

// =============================================================================
// AuditLog — trilha de auditoria imutável (Dossie 8, Secao 16 e RN-32)
// =============================================================================

/// Registro de auditoria genérico e polimórfico (Dossiê 8, Seção 16.3 —
/// mesmo trade-off documentado ali: perde-se FK nativa forte por
/// `entidadeTipo`/`entidadeId`, ganha-se não precisar de uma tabela
/// `AuditLogCompany`/`AuditLogDriver`/... por domínio). Nunca aceita
/// UPDATE/DELETE via aplicação — apenas INSERT (módulo Audit, Dossiê 13
/// Seção 20, expõe somente leitura).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  companyId    String  @db.Uuid
  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entidadeTipo String
  entidadeId   String
  acao         String

  atorUserId String? @db.Uuid
  atorUser   User?   @relation(fields: [atorUserId], references: [id], onDelete: SetNull)

  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([companyId, entidadeTipo, entidadeId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Session/PasswordResetToken/Invite — modulo Auth (Dossie 15, `AUTH-*`)
// =============================================================================

/// Uma sessao = um refresh token ativo em um dispositivo (Dossie 12,
/// Secao 4.3/4.4 e `AUTH-06`, "Meus dispositivos"). O valor bruto do
/// refresh token nunca e persistido — apenas seu hash (mesma logica de
/// nao guardar segredo em claro que `passwordHash`), permitindo revogar
/// (`revokedAt`) e detectar reuso (rotacao) sem expor o token caso o
/// banco vaze. `deviceName`/`ip`/`userAgent` sao o que a tela "Meus
/// dispositivos" exibe; nenhum dado de geolocalizacao precisa e
/// resolvido (aproximado o suficiente para o usuario reconhecer o
/// dispositivo, nunca usado para decisao de seguranca automatica).
///
/// `tenantId`/`role`/`vinculoId` fixam sob qual `Membership` esta sessao
/// foi emitida (Dossie 15, `AUTH-02`) — o `/auth/refresh` reemite um
/// `access_token` para o MESMO vinculo, nunca permite que o cliente troque
/// de perfil silenciosamente apenas girando o refresh token; trocar de
/// perfil exige um novo login com o seletor.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String  @unique
  deviceName       String?
  ip               String?
  userAgent        String?

  tenantId  String? @db.Uuid
  role      String
  vinculoId String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Token de uso unico para o fluxo "Esqueci minha senha" (`AUTH-03`).
/// `RN-AUTH-04`: uma redefinicao bem-sucedida revoga todas as `Session`
/// ativas do usuario — implementado na camada de aplicacao
/// (`AuthService`), nunca aqui (este model so guarda o token em si).
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Convite de papel emitido por uma Empresa/Gestor (ex. motorista) —
/// nunca cria uma nova `Company`, apenas um `Membership` no tenant
/// convidante quando resgatado. `codigo` e o valor curto mostrado ao
/// usuario (ex. "M586PO"); o link de convite (`RTA-8F29KQ` no
/// briefing) e apenas esse mesmo codigo embutido em uma URL do site —
/// nao um valor separado. Estado e modelado por timestamps
/// (`usadoEm`/`revogadoEm`) em vez de um enum de status, seguindo a
/// mesma convencao ja usada em `Company.deletedAt`/`Membership.encerradoEm`.
model Invite {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Valor de `Role` (mesma convencao de `Membership.role`) — papel que
  /// o convidado assumira ao resgatar.
  role String

  codigo String @unique

  criadoPorId String @db.Uuid
  criadoPor   User   @relation("InviteCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  usadoPorId String? @db.Uuid
  usadoPor   User?   @relation("InviteUsadoPor", fields: [usadoPorId], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  usadoEm    DateTime?
  revogadoEm DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("invites")
}

// =============================================================================
// Vehicle — modulo Veiculos (Dossie 13, Secao 9)
// =============================================================================

/// Veículo do tenant (briefing "Gestão de Veículos"). "Todo veículo
/// obrigatoriamente pertence a um único Tenant... Nunca poderá existir
/// compartilhamento de veículos entre empresas diferentes" — RLS por
/// `companyId` (mesmo mecanismo de `Membership`/`Invite`).
///
/// `placa` é `@unique` GLOBALMENTE (não `@@unique([companyId, placa])`)
/// — mesma decisão de `Company.cpfCnpj`: identifica um veículo físico
/// real, então a checagem de duplicidade do briefing precisa valer
/// mesmo entre tenants diferentes (um veículo não pode ser cadastrado
/// duas vezes na plataforma), apesar de a visibilidade de linhas
/// continuar isolada por RLS.
///
/// Campos "Última posição/viagem/motorista/monitor" (briefing
/// "LOCALIZAÇÃO") são um snapshot desnormalizado, atualizado pelos
/// próprios endpoints deste módulo (posição e vínculo) — não existe
/// ainda um pipeline de GPS/Trips real (`GpsModule`/`TripsModule` são
/// stubs vazios); `viagemAtualId` é deliberadamente uma `String?` sem
/// `@relation` (nenhuma tabela de Viagem existe para referenciar ainda)
/// — populado quando o módulo de Viagens existir, documentado como
/// lacuna conhecida (mesma disciplina do stub da Rotta AI).
model Vehicle {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  placa                 String
  modelo                String
  marca                 String?
  ano                   Int?
  cor                   String?
  renavam               String?
  chassi                String?
  capacidadePassageiros Int
  tipo                  VehicleType
  categoria             VehicleCategory @default(ESCOLAR)
  observacoes           String?
  fotoUrl               String?

  status VehicleStatus @default(DISPONIVEL)

  quilometragemAtual Int @default(0)

  ultimaLatitude  Decimal?  @db.Decimal(9, 6)
  ultimaLongitude Decimal?  @db.Decimal(9, 6)
  ultimaPosicaoEm DateTime?
  /// Sem `@relation` — ver nota do model acima ("Viagens" ainda não existe).
  viagemAtualId   String?

  ultimoMotoristaId String? @db.Uuid
  ultimoMotorista   User?   @relation("VehicleUltimoMotorista", fields: [ultimoMotoristaId], references: [id], onDelete: SetNull)
  ultimoMonitorId   String? @db.Uuid
  ultimoMonitor     User?   @relation("VehicleUltimoMonitor", fields: [ultimoMonitorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — "Nunca apagar registros" (briefing "VINCULAÇÃO"),
  /// mesma convenção de `Company.deletedAt`.
  deletedAt DateTime?

  documentos  VehicleDocument[]
  manutencoes VehicleMaintenance[]
  lembretes   VehicleReminder[]
  vinculos    VehicleAssignment[]
  checklists  VehicleChecklist[]
  ocorrencias VehicleOccurrence[]

  @@unique([placa])
  @@index([companyId, status])
  @@index([companyId, tipo])
  @@index([companyId, deletedAt])
  @@map("vehicles")
}

/// Documento/foto anexado ao veículo (briefing "DOCUMENTAÇÃO"). `companyId`
/// é desnormalizado de `vehicleId` (sem `@relation` própria para
/// `Company` — evita inflar `Company` com mais um array de volta só
/// para permitir que a policy RLS leia a coluna) apenas para a policy
/// de RLS e para filtrar sem precisar de join; a integridade
/// referencial real vem de `vehicleId` (`onDelete: Cascade`).
model VehicleDocument {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  /// Preenchido quando o documento é um anexo de uma manutenção
  /// específica (briefing "MANUTENÇÃO" — "Anexos"), em vez de um
  /// documento do veículo em si (CRLV/Seguro/etc.).
  maintenanceId String?             @db.Uuid
  maintenance   VehicleMaintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  tipo         VehicleDocumentType
  nomeOriginal String
  mimeType     String
  fileUrl      String
  vencimentoEm DateTime?

  /// Análise assíncrona da Rotta AI (briefing "ROTTA AI") — sempre
  /// `INDISPONIVEL` hoje (`RottaAiService` é um stub, Dossiê 15); o
  /// upload em si nunca é bloqueado esperando por ela.
  rottaAiStatus              VehicleDocumentAiStatus @default(PENDENTE)
  rottaAiQualidadeOk         Boolean?
  rottaAiLegivel             Boolean?
  rottaAiSuspeitaAdulteracao Boolean?
  rottaAiObservacoes         String?
  rottaAiAnalisadoEm         DateTime?

  uploadedByUserId String @db.Uuid
  uploadedBy       User   @relation("VehicleDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  /// Soft delete — histórico de documentos anteriores nunca é apagado
  /// fisicamente (briefing "Sempre manter histórico").
  deletedAt DateTime?

  @@index([companyId, vehicleId, tipo])
  @@index([companyId, vencimentoEm])
  @@map("vehicle_documents")
}

/// Registro de manutenção (briefing "MANUTENÇÃO") — histórico
/// append-only (nunca editado após criado, apenas `observacoes`
/// poderia em tese ser corrigida, mas o módulo não expõe update:
/// qualquer correção é um novo registro, preservando a trilha real do
/// que foi feito no veículo).
model VehicleMaintenance {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  tipo          VehicleMaintenanceType
  data          DateTime
  quilometragem Int?
  valorCentavos Int?
  fornecedor    String?
  observacoes   String?

  registradoPorId String @db.Uuid
  registradoPor   User   @relation("VehicleMaintenanceRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  anexos VehicleDocument[]

  @@index([companyId, vehicleId, tipo])
  @@index([companyId, data])
  @@map("vehicle_maintenances")
}

/// Lembrete automático de vencimento (briefing "LEMBRETES").
/// `origemDocumentoId` (sem `@relation` — apenas referência informativa)
/// é preenchido quando o lembrete foi auto-gerado a partir do
/// `vencimentoEm` de um `VehicleDocument` (CRLV/Seguro/Licenciamento/
/// Vistoria); lembretes de revisão/troca de óleo são criados
/// manualmente (por data OU por quilometragem-alvo).
model VehicleReminder {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  tipo              VehicleReminderType
  dataAlvo          DateTime
  quilometragemAlvo Int?
  status            VehicleReminderStatus @default(PENDENTE)
  observacoes       String?
  origemDocumentoId String?               @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidoEm DateTime?

  @@index([companyId, vehicleId, status])
  @@index([companyId, dataAlvo])
  @@map("vehicle_reminders")
}

/// Vínculo Veículo<->Motorista/Monitor (briefing "VINCULAÇÃO") — "Um
/// veículo poderá ser utilizado por diferentes motoristas ao longo do
/// tempo... Todo histórico deverá ser preservado." Nunca é
/// UPDATE/DELETE físico: encerrar um vínculo é `encerradoEm = now()` +
/// criar um novo registro para o novo motorista/monitor, mesma
/// convenção de `Membership.encerradoEm`. `encerradoEm = null` é o
/// vínculo vigente.
model VehicleAssignment {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  papel  VehicleAssignmentRole
  userId String                @db.Uuid
  user   User                  @relation("VehicleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  iniciadoEm  DateTime  @default(now())
  encerradoEm DateTime?

  criadoPorId String @db.Uuid
  criadoPor   User   @relation("VehicleAssignmentCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([companyId, vehicleId, papel, encerradoEm])
  @@index([companyId, userId])
  @@map("vehicle_assignments")
}

/// Checklist opcional pré-viagem preenchido pelo motorista (briefing
/// "CHECKLIST") — sempre INSERT, nunca UPDATE/DELETE ("Salvar
/// histórico"). `viagemId` segue a mesma lacuna documentada em
/// `Vehicle.viagemAtualId` (Trips ainda não existe).
model VehicleChecklist {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  motoristaId String @db.Uuid
  motorista   User   @relation("VehicleChecklistMotorista", fields: [motoristaId], references: [id], onDelete: Restrict)

  viagemId String?

  pneusOk                    Boolean @default(true)
  lucesOk                    Boolean @default(true)
  combustivelOk              Boolean @default(true)
  limpezaOk                  Boolean @default(true)
  equipamentosObrigatoriosOk Boolean @default(true)
  observacoes                String?

  createdAt DateTime @default(now())

  @@index([companyId, vehicleId, createdAt])
  @@index([companyId, motoristaId])
  @@map("vehicle_checklists")
}

/// Ocorrência/incidente reportado pelo app mobile (briefing "APP
/// MOBILE" — tela "Ocorrências"), ex. avaria, pane, acidente. Sempre
/// INSERT — histórico de ocorrências nunca é editado/apagado.
model VehicleOccurrence {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  reportadoPorId String @db.Uuid
  reportadoPor   User   @relation("VehicleOccurrenceReportadoPor", fields: [reportadoPorId], references: [id], onDelete: Restrict)

  titulo     String
  descricao  String
  severidade VehicleOccurrenceSeverity @default(MEDIA)
  fotoUrls   String[]

  createdAt DateTime @default(now())

  @@index([companyId, vehicleId, createdAt])
  @@map("vehicle_occurrences")
}
