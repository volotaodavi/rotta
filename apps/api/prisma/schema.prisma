// Schema Prisma da Rotta — Dossie 8 (modelagem de dados) e Dossie 12 (Secao 6).
//
// ESTADO ATUAL: primeiro recorte real do schema, introduzido pelo modulo
// de Empresas (Tenant) — Dossie 8, Secao 3, e Dossie 16 (`EMP-*`). Os
// modelos abaixo cobrem exatamente o que os modulos Empresas/Usuarios/
// Auditoria precisam hoje; os demais 19 dominios do Dossie 13 chegam
// junto com cada modulo real (nunca especulativamente adiantados aqui).
//
// PostGIS habilitado a partir do Map Intelligence Agent (Rotta Geo
// Platform, Dossie 8 Secao 22): `School.pontoGeografico` (campo
// `Unsupported`, ver model `School`) e um `geography(Point,4326)`
// mantido por trigger de banco (migration
// `20260803192602_geo_map_intelligence`) com indice espacial GiST —
// Prisma Client nao le/escreve esse campo diretamente (tipo
// `Unsupported`), so o `MapIntelligenceService`/`SchoolMarkerRepository`
// (`$queryRaw`) o usam. Particionamento declarativo da tabela
// PosicaoGPS ainda nao habilitado (chega com o modulo Rotas).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// =============================================================================
// Enums
// =============================================================================

/// Forma societaria da Empresa/Tenant (Dossie 16, `EMP-01`). `AUTONOMO`
/// dispara a regra "o motorista automaticamente e o Administrador da
/// empresa" (Dossie 16, Secao 1.2) — o proprio motorista assina o CPF em
/// `cpfCnpj` e vira o unico `Membership` com papel `empresa`.
enum CompanyType {
  AUTONOMO
  MEI
  LTDA
  SLU
  EIRELI
  OUTRO
}

/// Ciclo de vida comercial da Empresa/Tenant (Dossie 16, `EMP-04`/`EMP-05`).
enum CompanyStatus {
  TRIAL
  ATIVO
  SUSPENSO
  CANCELADO
  INADIMPLENTE
}

/// Status da conta de identidade global `User` — independente de em
/// quantos tenants o usuario tem `Membership` (Dossie 8, Secao 2).
enum UserStatus {
  ATIVO
  INATIVO
}

/// Status do vinculo Usuario<->Empresa<->Papel (Dossie 8, Secao 2 —
/// `VinculoPapel`). Um `Membership` `REMOVIDO` e preservado (nunca
/// apagado) para trilha de auditoria de quem já pertenceu ao tenant.
enum MembershipStatus {
  ATIVO
  SUSPENSO
  REMOVIDO
}

/// Carroceria/porte do veículo (Dossie 13, Secao 9, `VEI-01`).
enum VehicleType {
  AUTOMOVEL
  SEDAN
  SUV
  MINIVAN
  VAN
  MICRO_ONIBUS
  ONIBUS
  OUTRO
}

/// Finalidade de uso do veículo — separado de `VehicleType` (que é a
/// carroceria) porque um mesmo tipo (ex. Van) pode operar tanto
/// transporte escolar quanto fretamento avulso.
enum VehicleCategory {
  ESCOLAR
  FRETAMENTO
  PARTICULAR
  OUTRO
}

/// Ciclo de vida operacional do veículo (`VEI-06`). Transições são
/// sempre explícitas via `VehiclesService` (nunca infere-se
/// `EM_VIAGEM`/`MANUTENCAO` por efeito colateral de outro módulo sem
/// uma chamada própria) — `TripsModule`/`RoutesModule` ainda não
/// existem (ver nota em `Vehicle.viagemAtualId`), então por ora o único
/// disparador real de `EM_VIAGEM` é a própria API (endpoint de status).
enum VehicleStatus {
  DISPONIVEL
  EM_VIAGEM
  MANUTENCAO
  RESERVA
  INATIVO
  BLOQUEADO
}

/// Tipo de documento anexável ao veículo (briefing "DOCUMENTAÇÃO").
enum VehicleDocumentType {
  CRLV
  LICENCIAMENTO
  SEGURO
  LAUDO
  VISTORIA
  FOTO
  OUTRO
}

/// Resultado da análise assíncrona da Rotta AI sobre um
/// `VehicleDocument` (briefing "ROTTA AI"). `INDISPONIVEL` é o valor
/// hoje sempre atribuído — `RottaAiService` é um stub (Dossiê 15) sem
/// provedor de visão computacional/OCR contratado; o upload do
/// documento nunca fica bloqueado esperando por ela.
enum VehicleDocumentAiStatus {
  PENDENTE
  APROVADO
  REPROVADO
  INDISPONIVEL
}

/// Tipo de manutenção (briefing "MANUTENÇÃO").
enum VehicleMaintenanceType {
  TROCA_OLEO
  PNEUS
  FREIOS
  REVISAO
  VISTORIA
  LIMPEZA
  OUTRA
}

/// Tipo de lembrete automático (briefing "LEMBRETES").
enum VehicleReminderType {
  LICENCIAMENTO
  SEGURO
  REVISAO
  TROCA_OLEO
  MANUTENCAO_PREVENTIVA
  VISTORIA
}

/// Estado do lembrete — computado como "vencendo"/"vencido" na camada de
/// aplicação a partir de `dataAlvo` (nunca um job agendado só para
/// isso); este enum guarda apenas o estado que exige ação humana.
enum VehicleReminderStatus {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

/// Papel do vínculo em `VehicleAssignment` (briefing "VINCULAÇÃO").
enum VehicleAssignmentRole {
  MOTORISTA
  MONITOR
}

/// Severidade de uma `VehicleOccurrence` reportada pelo app (briefing
/// "Ocorrências").
enum VehicleOccurrenceSeverity {
  BAIXA
  MEDIA
  ALTA
}

/// Nível/modalidade de ensino ofertado (briefing "TIPOS") — array em
/// `School.tipos`, nunca um único valor: uma mesma unidade física
/// comumente oferta mais de um nível (ex. Creche + Pré-escola).
enum SchoolType {
  CRECHE
  PRE_ESCOLA
  FUNDAMENTAL
  MEDIO
  EJA
  TECNICO
  UNIVERSIDADE
  OUTRO
}

/// Dependência administrativa oficial (briefing "DEPENDÊNCIA
/// ADMINISTRATIVA") — mesma classificação usada pelo Censo Escolar do
/// INEP, para que a sincronização futura (`School.codigoInep`) mapeie
/// 1:1 sem tradução.
enum SchoolAdministrativeDependency {
  FEDERAL
  ESTADUAL
  MUNICIPAL
  PRIVADA
  FILANTROPICA
  COMUNITARIA
}

/// Turno atendido pela escola (briefing "TURNOS") — array em
/// `School.turnosAtendidos`, já que a maioria das escolas atende mais
/// de um turno.
enum SchoolShift {
  MANHA
  TARDE
  INTEGRAL
  NOITE
  PERSONALIZADO
}

/// Ciclo de vida do registro no catálogo (briefing "STATUS"). Cadastro
/// manual (Empresa/Gestor/Admin Rotta) entra direto `ATIVA`;
/// `EM_ANALISE` é reservado para o resultado de importação em lote e
/// de sincronização INEP (`SchoolsService`, briefing "IMPORTAÇÃO" —
/// decisão de produto: dado de origem externa/lote é revisado antes de
/// aparecer em buscas/mapas por padrão).
enum SchoolStatus {
  ATIVA
  INATIVA
  EM_ANALISE
  ARQUIVADA
}

/// Papel de um `SchoolAccessPoint` (briefing "LOCALIZAÇÃO" +
/// "PORTÕES E PONTOS DE EMBARQUE" — as duas seções descrevem a MESMA
/// coleção de pontos: "Localização" apenas destaca, no mapa, os pontos
/// cujo `tipo` é um destes três papéis reservados).
enum SchoolAccessPointType {
  ENTRADA_PRINCIPAL
  PONTO_EMBARQUE
  PONTO_DESEMBARQUE
  OUTRO
}

/// Status de uma tentativa de geocodificação da Rotta Geo Platform
/// (briefing "ROTTA GEO PLATFORM" §"VALIDATION AI AGENT"). `PENDENTE`
/// é o estado inicial (Geocoding AI Agent acabou de gravar); o
/// Validation AI Agent decide entre `VALIDADO` (copiado para
/// `School.latitude`/`longitude`) e `REPROCESSAR` (nova tentativa,
/// nunca mais que 3 — a 4ª reprovação vira `REVISAO_MANUAL`, nunca um
/// loop infinito).
enum SchoolCoordinateStatus {
  PENDENTE
  VALIDADO
  REPROCESSAR
  REVISAO_MANUAL
}

/// De onde veio a coordenada de uma tentativa (briefing "SCHOOL
/// COORDINATES" §"FONTE") — `NOMINATIM` é o caminho normal (Geocoding AI
/// Agent, Rotta Geo Engine sobre OpenStreetMap/Nominatim); `MANUAL` cobre
/// correção humana na Fila de Revisão Manual.
enum SchoolCoordinateSource {
  NOMINATIM
  MANUAL
}

/// Histórico/auditoria de geocodificação de uma Escola (briefing
/// "ROTTA GEO PLATFORM" §"BANCO DE DADOS" — "School Coordinates"). Cada
/// tentativa do Geocoding AI Agent grava UMA linha aqui; NUNCA é a
/// fonte de leitura para "onde fica esta escola" (isso continua sendo
/// `School.latitude`/`longitude`, já lido por Marketplace/mapas/rotas
/// hoje) — o Map Intelligence Agent copia a tentativa `VALIDADO` mais
/// recente para lá assim que ela é aprovada. Manter os dois separados
/// evita duas fontes de verdade divergentes: este model é o "porquê"
/// (proveniência/auditoria/fila de revisão), `School` é o "o quê"
/// (valor atual, já usado por todo o resto da plataforma).
model SchoolCoordinate {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  latitude  Decimal                @db.Decimal(9, 6)
  longitude Decimal                @db.Decimal(9, 6)
  /// Texto livre com o retorno de precisão do provedor (ex.
  /// `importance` do Nominatim) — sem enum fechado porque o vocabulário
  /// varia por provedor (briefing não define um próprio).
  precisao  String?
  fonte     SchoolCoordinateSource @default(NOMINATIM)
  status    SchoolCoordinateStatus @default(PENDENTE)

  /// Quantas vezes esta escola já foi reprocessada (briefing: "Limite
  /// máximo: 3 tentativas automáticas") — contínuo por escola: cada
  /// nova tentativa grava `tentativaAnterior + 1`, nunca reinicia.
  tentativa Int @default(1)

  validadoPorIa Boolean @default(false)
  motivoRevisao String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
  @@index([status])
  @@map("school_coordinates")
}

/// Sexo do aluno (briefing "CADASTRO DO ALUNO", módulo Marketplace).
enum StudentSex {
  MASCULINO
  FEMININO
  OUTRO
}

/// Status da solicitação de transporte (briefing "SOLICITAÇÃO").
enum TransportRequestStatus {
  RECEBIDA
  EM_ANALISE
  APROVADA
  RECUSADA
}

/// Ciclo de vida do contrato (briefing "CONTRATO"/"TRANSPORTE ATIVO").
enum ContractStatus {
  AGUARDANDO_ASSINATURA
  ATIVO
  ENCERRADO
}

/// Alvo de uma avaliação (briefing "AVALIAÇÕES") — ver nota de
/// polimorfismo em `Rating.alvoId`.
enum RatingTargetType {
  MOTORISTA
  EMPRESA
  MONITOR
  VEICULO
}

// =============================================================================
// Plan — estrutura extensivel de planos comerciais (Dossie 16, Secao "Plano")
// =============================================================================

/// Catalogo de planos comerciais. Modelado como tabela (nao enum) desde o
/// primeiro plano ("Starter") especificamente para que novos planos sejam
/// uma migration de dado (`INSERT`), nunca uma migration de schema —
/// requisito explicito do briefing ("Criar estrutura para futuros
/// planos"). Populado por `prisma/seed.ts`, nunca por migration manual.
model Plan {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  priceCents Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies Company[]

  @@map("plans")
}

// =============================================================================
// Company — o Tenant (Dossie 8, Secao 3 e Dossie 16)
// =============================================================================

/// A Empresa É o tenant (Dossie 8, Secao 1: "toda empresa cadastrada será
/// um tenant independente") — não existe uma tabela `Tenant` separada.
/// `Company.id` é o valor que circula como `tenant_id` em toda tabela de
/// negócio do restante da plataforma (`Membership.companyId`,
/// `CompanySetting.companyId`, `AuditLog.companyId`, e futuramente
/// `Driver.companyId`, `Vehicle.companyId` etc.).
///
/// Configurações operacionais (tema, canais de notificação, integrações)
/// NÃO são colunas aqui — vivem em `CompanySetting` (chave/valor tipado),
/// exatamente pela razão do Dossiê 8, Seção 3.2: esta tabela é lida em
/// praticamente toda requisição autenticada do sistema e deve permanecer
/// enxuta e estável; configurações tendem a crescer em número a cada
/// funcionalidade nova, o que geraria migrations constantes aqui.
model Company {
  id String @id @default(uuid()) @db.Uuid

  razaoSocial  String
  nomeFantasia String
  /// CPF (motorista autônomo) ou CNPJ (demais tipos) — único globalmente,
  /// validado na camada de aplicação (`@rotta/validators`), nunca apenas
  /// no formato (dígito verificador real).
  cpfCnpj      String      @unique
  tipo         CompanyType

  email    String
  telefone String
  whatsapp String?

  cep         String
  endereco    String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)

  logoUrl     String?
  fotoUrl     String?
  corPrimaria String  @default("#3B6EF6")
  idioma      String  @default("pt-BR")
  fusoHorario String  @default("America/Sao_Paulo")

  status CompanyStatus @default(TRIAL)
  planId String        @db.Uuid
  plan   Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete (Dossie 16, "Excluir Empresa") — nunca DELETE físico.
  /// Distinto de `status = CANCELADO`: cancelamento é uma transição de
  /// ciclo de vida comercial visível/reversível (Admin Rotta reativa);
  /// `deletedAt` é a exclusão administrativa (ex. registro de teste
  /// criado por engano), que sai das listagens por padrão mas preserva a
  /// linha para integridade referencial do histórico de auditoria.
  deletedAt DateTime?

  memberships            Membership[]
  settings               CompanySetting[]
  auditLogs              AuditLog[]
  invites                Invite[]
  vehicles               Vehicle[]
  escolasVinculadas      SchoolCompanyLink[]
  solicitacoesTransporte TransportRequest[]
  contratos              Contract[]
  avaliacoesRecebidas    Rating[]
  /// Só alimenta o dashboard de comunicação da empresa (briefing "CENTRAL
  /// DE COMUNICAÇÃO") — nunca usado para controle de acesso ao inbox
  /// pessoal do destinatário (ver nota em `Notification`).
  notifications          Notification[]
  rotas                  Route[]
  viagens                Trip[]
  /// Carteira Rotta Pay da empresa (Dossiê 26) — opcional porque só
  /// passa a existir quando a primeira movimentação acontece
  /// (`WalletService.getOrCreate`), nunca criada no cadastro da empresa.
  wallet                 Wallet?

  @@index([status])
  @@index([tipo])
  @@index([deletedAt])
  @@map("companies")
}

/// Configuração operacional chave/valor tipada por tenant (Dossie 8,
/// Seção 3.2). `tipo` guarda o tipo lógico do valor serializado em
/// `valor` (`string` | `boolean` | `number` | `json`) — a validação e
/// desserialização tipada acontece na camada de aplicação
/// (`CompanySettingsService`), nunca no banco.
model CompanySetting {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  chave String
  tipo  String
  valor String

  updatedAt DateTime @updatedAt

  @@unique([companyId, chave])
  @@map("company_settings")
}

// =============================================================================
// User — identidade global (Dossie 8, Secao 2)
// =============================================================================

/// Identidade de login, GLOBAL — deliberadamente sem `tenant_id` própria.
/// Um `User` pode ter múltiplos `Membership` em tenants diferentes (ex.:
/// é responsável de um filho na Empresa A e, paralelamente, motorista
/// autônomo cadastrado como Empresa B) — Dossie 8, Seção 2, "VinculoPapel".
/// A autenticação (login/sessão/refresh token) é escopo do módulo Auth
/// (Dossiê 15), ainda não implementado; este módulo modela apenas o
/// suficiente da identidade (incluindo `passwordHash`) para que o
/// cadastro de Empresa possa criar o primeiro usuário administrador sem
/// que o Auth precise remodelar esta tabela depois.
///
/// Campos de autenticação (Dossiê 15, `AUTH-02`/`RN-AUTH-02`) chegam
/// junto com o módulo Auth: `tentativasLoginFalhas`/`bloqueadoAte`
/// implementam o bloqueio progressivo após 5 tentativas malsucedidas em
/// 15 minutos; `consentimentoLgpdAceitoEm` registra o momento da
/// aceitação dos termos no cadastro (LGPD, nunca inferido/assumido).
model User {
  id String @id @default(uuid()) @db.Uuid

  nome         String
  email        String @unique
  telefone     String @unique
  cpf          String @unique
  passwordHash String

  status    UserStatus @default(ATIVO)
  avatarUrl String?

  tentativasLoginFalhas     Int       @default(0)
  bloqueadoAte              DateTime?
  consentimentoLgpdAceitoEm DateTime?

  /// Marca a conta como Administrador Rotta (Dossie 8, Secao 2: "unico
  /// papel sem tenantId, funcionario da Rotta, contas criadas
  /// internamente pela equipe, nunca por self-service") — nao modelado
  /// como uma Company/Membership falsa; o login le esta flag ANTES de
  /// procurar Membership. Nunca setavel por nenhuma rota publica.
  isAdminRotta Boolean @default(false)

  /// Marca a conta como Responsável (módulo Marketplace) — identidade
  /// GLOBAL sem `Membership`/tenant próprio, mesmo mecanismo de
  /// `isAdminRotta` (o login lê esta flag ANTES de exigir Membership).
  /// Diferente de `isAdminRotta`: nada impede a MESMA pessoa de também
  /// ter `Membership`s (ex. Responsável de um filho e, paralelamente,
  /// motorista autônomo — Dossie 8 §2, comentário em `User` acima);
  /// nesse caso o login oferece as duas identidades como perfis
  /// distintos, mesmo padrão de `requiresProfileSelection`.
  isResponsavel Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships         Membership[]
  auditLogs           AuditLog[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitesCriados      Invite[]             @relation("InviteCriadoPor")
  invitesUsados       Invite[]             @relation("InviteUsadoPor")

  /// Relações do módulo Veículos (Dossiê 13, Secao 9) — um `User` pode
  /// ser referenciado por um `Vehicle`/`VehicleDocument`/etc. de várias
  /// formas distintas (quem enviou o documento vs. quem foi o último
  /// motorista vs. quem registrou uma manutenção), daí os múltiplos
  /// relacionamentos nomeados, mesmo padrão de `InviteCriadoPor`/`InviteUsadoPor`.
  veiculosUltimoMotorista       Vehicle[]            @relation("VehicleUltimoMotorista")
  veiculosUltimoMonitor         Vehicle[]            @relation("VehicleUltimoMonitor")
  documentosVeiculoEnviados     VehicleDocument[]    @relation("VehicleDocumentUploadedBy")
  manutencoesVeiculoRegistradas VehicleMaintenance[] @relation("VehicleMaintenanceRegistradoPor")
  vinculosVeiculo               VehicleAssignment[]  @relation("VehicleAssignmentUser")
  vinculosVeiculoCriados        VehicleAssignment[]  @relation("VehicleAssignmentCriadoPor")
  checklistsVeiculo             VehicleChecklist[]   @relation("VehicleChecklistMotorista")
  ocorrenciasVeiculoReportadas  VehicleOccurrence[]  @relation("VehicleOccurrenceReportadoPor")

  /// Relações do módulo Escolas (Dossiê 13, Secao 10).
  escolasCriadas           School[]            @relation("SchoolCriadoPor")
  vinculosEscola           SchoolCompanyLink[] @relation("SchoolCompanyLinkVinculadoPor")
  vinculosEscolaEncerrados SchoolCompanyLink[] @relation("SchoolCompanyLinkEncerradoPor")

  /// Relações do módulo Marketplace (Alunos/Solicitações/Contratos/
  /// Avaliações) — um `User` no papel de Responsável tem `alunos`/
  /// `solicitacoesTransporte`/`contratos`/`avaliacoesFeitas`; o mesmo
  /// `User` pode também aparecer como `contratosMotorista`/
  /// `contratosMonitor` quando atua como Motorista/Monitor de uma
  /// Empresa (Dossiê 8 §2 — "múltiplos papéis simultâneos").
  alunos                 Student[]          @relation("StudentResponsavel")
  solicitacoesTransporte TransportRequest[] @relation("TransportRequestResponsavel")
  contratos              Contract[]         @relation("ContractResponsavel")
  contratosMotorista     Contract[]         @relation("ContractMotorista")
  contratosMonitor       Contract[]         @relation("ContractMonitor")
  avaliacoesFeitas       Rating[]           @relation("RatingResponsavel")

  /// Relações do módulo Communication (briefing "ROTTA COMMUNICATION
  /// ENGINE") — inbox pessoal, dispositivos com Token FCM e preferências
  /// de canal/Quiet Hours; `notificationPreference` é opcional porque só
  /// existe a partir da primeira vez que o usuário grava uma preferência
  /// (o efetivo default é aplicado em código quando ausente).
  notifications          Notification[]
  deviceTokens           DeviceToken[]
  notificationPreference NotificationPreference?

  /// Relações do módulo Rotas/GPS (Dossiê 13, Secao 12 e Dossiê 18) — um
  /// `User` pode ser motorista/monitor padrão de uma `Route`, motorista/
  /// monitor de uma `Trip` específica, ou quem processou um checklist de
  /// embarque/desembarque (`TripStudentEvent`).
  rotasMotoristaPadrao    Route[]            @relation("RouteMotoristaPadrao")
  rotasMonitorPadrao      Route[]            @relation("RouteMonitorPadrao")
  viagensMotorista        Trip[]             @relation("TripMotorista")
  viagensMonitor          Trip[]             @relation("TripMonitor")
  eventosAlunoProcessados TripStudentEvent[] @relation("TripStudentEventProcessadoPor")

  /// Relações do módulo Rotta Pay (Dossiê 26) — carteira própria quando
  /// atua como Motorista (`Membership` com `role = MOTORISTA`), e as
  /// transações/saques que este usuário solicitou/registrou (podendo ser
  /// de QUALQUER carteira — Admin Rotta confirmando um crédito de uma
  /// empresa, por exemplo, daí não ser o mesmo relacionamento de `walletMotorista`).
  walletMotorista   Wallet?
  transacoesCriadas WalletTransaction[] @relation("WalletTransactionCriadaPor")
  saquesSolicitados WithdrawalRequest[] @relation("WithdrawalRequestSolicitadoPor")

  @@map("users")
}

/// `VinculoPapel` do Dossiê 8, Seção 2: liga `User` + `Company` (tenant) +
/// papel (`Role`, `@rotta/types` — valores em `packages/types`/
/// `apps/api/src/shared/enums/role.enum.ts`, nunca redefinidos aqui).
/// Um mesmo par (usuário, empresa) pode ter mais de um papel simultâneo
/// em teoria; a combinação (`userId`, `companyId`, `role`) é única para
/// impedir duplicidade do mesmo vínculo.
model Membership {
  id String @id @default(uuid()) @db.Uuid

  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Valor de `Role` (Dossie 8, Secao 2) — string, nao enum do Prisma,
  /// para que a fonte unica de verdade continue sendo
  /// `apps/api/src/shared/enums/role.enum.ts` (consumido tambem por
  /// codigo que nao le o schema Prisma, ex. guards).
  role   String
  status MembershipStatus @default(ATIVO)

  convidadoPorId String?   @db.Uuid
  iniciadoEm     DateTime  @default(now())
  encerradoEm    DateTime?

  @@unique([userId, companyId, role])
  @@index([companyId, role, status])
  @@index([userId, status])
  @@map("memberships")
}

// =============================================================================
// AuditLog — trilha de auditoria imutável (Dossie 8, Secao 16 e RN-32)
// =============================================================================

/// Registro de auditoria genérico e polimórfico (Dossiê 8, Seção 16.3 —
/// mesmo trade-off documentado ali: perde-se FK nativa forte por
/// `entidadeTipo`/`entidadeId`, ganha-se não precisar de uma tabela
/// `AuditLogCompany`/`AuditLogDriver`/... por domínio). Nunca aceita
/// UPDATE/DELETE via aplicação — apenas INSERT (módulo Audit, Dossiê 13
/// Seção 20, expõe somente leitura).
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Opcional desde o módulo Escolas (Dossiê 13, `ESC-*`): registra o
  /// tenant do ATOR que executou a ação (para aparecer no audit trail
  /// da PRÓPRIA empresa), nunca necessariamente o "dono" da entidade —
  /// `School`/`SchoolAccessPoint` são catálogo compartilhado, sem
  /// tenant próprio (ver nota em `School`). Quando o ator é
  /// `Role.ADMIN_ROTTA` (sem `tenantId`, ex. sincronização INEP), esta
  /// coluna é `null` e a linha só é visível em bypass — RLS abaixo já
  /// cobre isso (`NULL = qualquer coisa` nunca é `true` no Postgres).
  companyId    String?  @db.Uuid
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entidadeTipo String
  entidadeId   String
  acao         String

  atorUserId String? @db.Uuid
  atorUser   User?   @relation(fields: [atorUserId], references: [id], onDelete: SetNull)

  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([companyId, entidadeTipo, entidadeId, createdAt])
  @@index([entidadeTipo, entidadeId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Session/PasswordResetToken/Invite — modulo Auth (Dossie 15, `AUTH-*`)
// =============================================================================

/// Uma sessao = um refresh token ativo em um dispositivo (Dossie 12,
/// Secao 4.3/4.4 e `AUTH-06`, "Meus dispositivos"). O valor bruto do
/// refresh token nunca e persistido — apenas seu hash (mesma logica de
/// nao guardar segredo em claro que `passwordHash`), permitindo revogar
/// (`revokedAt`) e detectar reuso (rotacao) sem expor o token caso o
/// banco vaze. `deviceName`/`ip`/`userAgent` sao o que a tela "Meus
/// dispositivos" exibe; nenhum dado de geolocalizacao precisa e
/// resolvido (aproximado o suficiente para o usuario reconhecer o
/// dispositivo, nunca usado para decisao de seguranca automatica).
///
/// `tenantId`/`role`/`vinculoId` fixam sob qual `Membership` esta sessao
/// foi emitida (Dossie 15, `AUTH-02`) — o `/auth/refresh` reemite um
/// `access_token` para o MESMO vinculo, nunca permite que o cliente troque
/// de perfil silenciosamente apenas girando o refresh token; trocar de
/// perfil exige um novo login com o seletor.
model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String  @unique
  deviceName       String?
  ip               String?
  userAgent        String?

  tenantId  String? @db.Uuid
  role      String
  vinculoId String

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Token de uso unico para o fluxo "Esqueci minha senha" (`AUTH-03`).
/// `RN-AUTH-04`: uma redefinicao bem-sucedida revoga todas as `Session`
/// ativas do usuario — implementado na camada de aplicacao
/// (`AuthService`), nunca aqui (este model so guarda o token em si).
model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Convite de papel emitido por uma Empresa/Gestor (ex. motorista) —
/// nunca cria uma nova `Company`, apenas um `Membership` no tenant
/// convidante quando resgatado. `codigo` e o valor curto mostrado ao
/// usuario (ex. "M586PO"); o link de convite (`RTA-8F29KQ` no
/// briefing) e apenas esse mesmo codigo embutido em uma URL do site —
/// nao um valor separado. Estado e modelado por timestamps
/// (`usadoEm`/`revogadoEm`) em vez de um enum de status, seguindo a
/// mesma convencao ja usada em `Company.deletedAt`/`Membership.encerradoEm`.
model Invite {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Valor de `Role` (mesma convencao de `Membership.role`) — papel que
  /// o convidado assumira ao resgatar.
  role String

  codigo String @unique

  criadoPorId String @db.Uuid
  criadoPor   User   @relation("InviteCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  usadoPorId String? @db.Uuid
  usadoPor   User?   @relation("InviteUsadoPor", fields: [usadoPorId], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  usadoEm    DateTime?
  revogadoEm DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("invites")
}

// =============================================================================
// Vehicle — modulo Veiculos (Dossie 13, Secao 9)
// =============================================================================

/// Veículo do tenant (briefing "Gestão de Veículos"). "Todo veículo
/// obrigatoriamente pertence a um único Tenant... Nunca poderá existir
/// compartilhamento de veículos entre empresas diferentes" — RLS por
/// `companyId` (mesmo mecanismo de `Membership`/`Invite`).
///
/// `placa` é `@unique` GLOBALMENTE (não `@@unique([companyId, placa])`)
/// — mesma decisão de `Company.cpfCnpj`: identifica um veículo físico
/// real, então a checagem de duplicidade do briefing precisa valer
/// mesmo entre tenants diferentes (um veículo não pode ser cadastrado
/// duas vezes na plataforma), apesar de a visibilidade de linhas
/// continuar isolada por RLS.
///
/// Campos "Última posição/viagem/motorista/monitor" (briefing
/// "LOCALIZAÇÃO") são um snapshot desnormalizado, atualizado pelos
/// próprios endpoints deste módulo (posição e vínculo) — não existe
/// ainda um pipeline de GPS/Trips real (`GpsModule`/`TripsModule` são
/// stubs vazios); `viagemAtualId` é deliberadamente uma `String?` sem
/// `@relation` (nenhuma tabela de Viagem existe para referenciar ainda)
/// — populado quando o módulo de Viagens existir, documentado como
/// lacuna conhecida (mesma disciplina do stub da Rotta AI).
model Vehicle {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  placa                 String
  modelo                String
  marca                 String?
  ano                   Int?
  cor                   String?
  renavam               String?
  chassi                String?
  capacidadePassageiros Int
  tipo                  VehicleType
  categoria             VehicleCategory @default(ESCOLAR)
  observacoes           String?
  fotoUrl               String?

  status VehicleStatus @default(DISPONIVEL)

  quilometragemAtual Int @default(0)

  ultimaLatitude  Decimal?  @db.Decimal(9, 6)
  ultimaLongitude Decimal?  @db.Decimal(9, 6)
  ultimaPosicaoEm DateTime?
  /// Agora uma `@relation` de verdade (era string solta enquanto o
  /// módulo Trips não existia) — a viagem `EM_ANDAMENTO` deste veículo,
  /// se houver. `onDelete: SetNull` porque encerrar/cancelar uma viagem
  /// nunca deve apagar o veículo.
  viagemAtualId   String?   @db.Uuid
  viagemAtual     Trip?     @relation("VehicleViagemAtual", fields: [viagemAtualId], references: [id], onDelete: SetNull)

  ultimoMotoristaId String? @db.Uuid
  ultimoMotorista   User?   @relation("VehicleUltimoMotorista", fields: [ultimoMotoristaId], references: [id], onDelete: SetNull)
  ultimoMonitorId   String? @db.Uuid
  ultimoMonitor     User?   @relation("VehicleUltimoMonitor", fields: [ultimoMonitorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — "Nunca apagar registros" (briefing "VINCULAÇÃO"),
  /// mesma convenção de `Company.deletedAt`.
  deletedAt DateTime?

  documentos  VehicleDocument[]
  manutencoes VehicleMaintenance[]
  lembretes   VehicleReminder[]
  vinculos    VehicleAssignment[]
  checklists  VehicleChecklist[]
  ocorrencias VehicleOccurrence[]
  contratos   Contract[]
  rotasPadrao Route[]
  viagens     Trip[]               @relation("TripVeiculo")

  @@unique([placa])
  @@index([companyId, status])
  @@index([companyId, tipo])
  @@index([companyId, deletedAt])
  @@map("vehicles")
}

/// Documento/foto anexado ao veículo (briefing "DOCUMENTAÇÃO"). `companyId`
/// é desnormalizado de `vehicleId` (sem `@relation` própria para
/// `Company` — evita inflar `Company` com mais um array de volta só
/// para permitir que a policy RLS leia a coluna) apenas para a policy
/// de RLS e para filtrar sem precisar de join; a integridade
/// referencial real vem de `vehicleId` (`onDelete: Cascade`).
model VehicleDocument {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  /// Preenchido quando o documento é um anexo de uma manutenção
  /// específica (briefing "MANUTENÇÃO" — "Anexos"), em vez de um
  /// documento do veículo em si (CRLV/Seguro/etc.).
  maintenanceId String?             @db.Uuid
  maintenance   VehicleMaintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  tipo         VehicleDocumentType
  nomeOriginal String
  mimeType     String
  fileUrl      String
  vencimentoEm DateTime?

  /// Análise assíncrona da Rotta AI (briefing "ROTTA AI") — sempre
  /// `INDISPONIVEL` hoje (`RottaAiService` é um stub, Dossiê 15); o
  /// upload em si nunca é bloqueado esperando por ela.
  rottaAiStatus              VehicleDocumentAiStatus @default(PENDENTE)
  rottaAiQualidadeOk         Boolean?
  rottaAiLegivel             Boolean?
  rottaAiSuspeitaAdulteracao Boolean?
  rottaAiObservacoes         String?
  rottaAiAnalisadoEm         DateTime?

  uploadedByUserId String @db.Uuid
  uploadedBy       User   @relation("VehicleDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  /// Soft delete — histórico de documentos anteriores nunca é apagado
  /// fisicamente (briefing "Sempre manter histórico").
  deletedAt DateTime?

  @@index([companyId, vehicleId, tipo])
  @@index([companyId, vencimentoEm])
  @@map("vehicle_documents")
}

/// Registro de manutenção (briefing "MANUTENÇÃO") — histórico
/// append-only (nunca editado após criado, apenas `observacoes`
/// poderia em tese ser corrigida, mas o módulo não expõe update:
/// qualquer correção é um novo registro, preservando a trilha real do
/// que foi feito no veículo).
model VehicleMaintenance {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  tipo          VehicleMaintenanceType
  data          DateTime
  quilometragem Int?
  valorCentavos Int?
  fornecedor    String?
  observacoes   String?

  registradoPorId String @db.Uuid
  registradoPor   User   @relation("VehicleMaintenanceRegistradoPor", fields: [registradoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  anexos VehicleDocument[]

  @@index([companyId, vehicleId, tipo])
  @@index([companyId, data])
  @@map("vehicle_maintenances")
}

/// Lembrete automático de vencimento (briefing "LEMBRETES").
/// `origemDocumentoId` (sem `@relation` — apenas referência informativa)
/// é preenchido quando o lembrete foi auto-gerado a partir do
/// `vencimentoEm` de um `VehicleDocument` (CRLV/Seguro/Licenciamento/
/// Vistoria); lembretes de revisão/troca de óleo são criados
/// manualmente (por data OU por quilometragem-alvo).
model VehicleReminder {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  tipo              VehicleReminderType
  dataAlvo          DateTime
  quilometragemAlvo Int?
  status            VehicleReminderStatus @default(PENDENTE)
  observacoes       String?
  origemDocumentoId String?               @db.Uuid

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  concluidoEm DateTime?

  @@index([companyId, vehicleId, status])
  @@index([companyId, dataAlvo])
  @@map("vehicle_reminders")
}

/// Vínculo Veículo<->Motorista/Monitor (briefing "VINCULAÇÃO") — "Um
/// veículo poderá ser utilizado por diferentes motoristas ao longo do
/// tempo... Todo histórico deverá ser preservado." Nunca é
/// UPDATE/DELETE físico: encerrar um vínculo é `encerradoEm = now()` +
/// criar um novo registro para o novo motorista/monitor, mesma
/// convenção de `Membership.encerradoEm`. `encerradoEm = null` é o
/// vínculo vigente.
model VehicleAssignment {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  papel  VehicleAssignmentRole
  userId String                @db.Uuid
  user   User                  @relation("VehicleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  iniciadoEm  DateTime  @default(now())
  encerradoEm DateTime?

  criadoPorId String @db.Uuid
  criadoPor   User   @relation("VehicleAssignmentCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@index([companyId, vehicleId, papel, encerradoEm])
  @@index([companyId, userId])
  @@map("vehicle_assignments")
}

/// Checklist opcional pré-viagem preenchido pelo motorista (briefing
/// "CHECKLIST") — sempre INSERT, nunca UPDATE/DELETE ("Salvar
/// histórico"). `viagemId` segue a mesma lacuna documentada em
/// `Vehicle.viagemAtualId` (Trips ainda não existe).
model VehicleChecklist {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  motoristaId String @db.Uuid
  motorista   User   @relation("VehicleChecklistMotorista", fields: [motoristaId], references: [id], onDelete: Restrict)

  viagemId String?

  pneusOk                    Boolean @default(true)
  lucesOk                    Boolean @default(true)
  combustivelOk              Boolean @default(true)
  limpezaOk                  Boolean @default(true)
  equipamentosObrigatoriosOk Boolean @default(true)
  observacoes                String?

  createdAt DateTime @default(now())

  @@index([companyId, vehicleId, createdAt])
  @@index([companyId, motoristaId])
  @@map("vehicle_checklists")
}

/// Ocorrência/incidente reportado pelo app mobile (briefing "APP
/// MOBILE" — tela "Ocorrências"), ex. avaria, pane, acidente. Sempre
/// INSERT — histórico de ocorrências nunca é editado/apagado.
model VehicleOccurrence {
  id        String  @id @default(uuid()) @db.Uuid
  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid

  reportadoPorId String @db.Uuid
  reportadoPor   User   @relation("VehicleOccurrenceReportadoPor", fields: [reportadoPorId], references: [id], onDelete: Restrict)

  titulo     String
  descricao  String
  severidade VehicleOccurrenceSeverity @default(MEDIA)
  fotoUrls   String[]

  createdAt DateTime @default(now())

  @@index([companyId, vehicleId, createdAt])
  @@map("vehicle_occurrences")
}

// =============================================================================
// Escolas — catalogo compartilhado (Dossie 13, Secao 10 / briefing "Gestao de Escolas")
// =============================================================================

/// DECISÃO ARQUITETURAL CENTRAL deste módulo, diferente de `Vehicle`:
/// uma Escola é uma instituição FÍSICA real, e múltiplas Empresas
/// (transportadoras concorrentes entre si) frequentemente atendem a
/// MESMA escola com rotas distintas — não existe "a escola da Empresa
/// X". Por isso `School` NÃO tem `companyId`/RLS (mesmo padrão de
/// `Plan`, "catálogo público compartilhado", nunca o de `Vehicle`).
/// O que É por tenant é o VÍNCULO `SchoolCompanyLink` — cada Empresa
/// mantém sua própria lista de "escolas que eu atendo", e é esse
/// vínculo (não a linha `School`) que soure o dashboard/RBAC de cada
/// tenant. Consequência prática: Empresa/Gestor podem cadastrar e
/// editar uma escola que OUTRA empresa já cadastrou (mesmo modelo
/// colaborativo do próprio Censo Escolar/INEP) — toda alteração é
/// auditada (`AuditLog`, `entidadeTipo = "School"`) exatamente para
/// tornar essa colaboração rastreável.
///
/// `codigoInep` é o identificador oficial nacional (Censo Escolar) —
/// único quando presente, mas OPCIONAL: escolas particulares pequenas
/// ou recém-abertas legitimamente não têm código INEP ainda.
///
/// Preparado para, mas NÃO implementa hoje: vínculo com Alunos/
/// Responsáveis/Rotas/Viagens (briefing "ALUNOS"/"ROTAS") — nenhum
/// desses módulos existe ainda no monorepo (mesma lacuna já registrada
/// em `Vehicle.viagemAtualId`); quando existirem, referenciam
/// `School.id` diretamente, sem precisar alterar este model.
model School {
  id                        String                         @id @default(uuid()) @db.Uuid
  /// Formatado em `SchoolsService.create()` (`ESC-000001`, `ESC-000002`,
  /// ...) a partir da sequência Postgres `schools_codigo_interno_seq`
  /// (criada via SQL na migration, Prisma não tem `sequence` nativa no
  /// schema) — nunca a UUID `id`, inadequada para digitação humana
  /// (rádio com o motorista, ligação de suporte). Nunca setável pelo cliente.
  codigoInterno             String                         @unique
  /// Código oficial do Censo Escolar (INEP) — único globalmente quando
  /// presente; ausência é uma condição de negócio válida, nunca "dado
  /// faltando por erro".
  codigoInep                String?                        @unique
  nomeOficial               String
  nomeFantasia              String?
  /// Rede de ensino (ex. "Rede Estadual de SP", "SESI", "Objetivo") —
  /// texto livre: nomenclatura varia demais entre municípios/redes
  /// privadas para caber em um enum fechado, ao contrário de
  /// `dependenciaAdministrativa` (classificação oficial fixa do INEP).
  redeEnsino                String?
  dependenciaAdministrativa SchoolAdministrativeDependency

  /// CPF (autônomo) ou CNPJ — opcional (briefing "CADASTRO"): nem toda
  /// escola pública tem CNPJ próprio (frequentemente é o da Secretaria
  /// de Educação mantenedora).
  cnpj     String?
  telefone String?
  whatsapp String?
  email    String?
  website  String?

  cep                    String
  logradouro             String
  numero                 String
  complemento            String?
  bairro                 String
  cidade                 String
  estado                 String
  pais                   String                                 @default("Brasil")
  latitude               Decimal?                               @db.Decimal(9, 6)
  longitude              Decimal?                               @db.Decimal(9, 6)
  observacoesLocalizacao String?
  /// `geography(Point,4326)` mantido por trigger de banco a partir de
  /// `latitude`/`longitude` (migration `20260803192602_geo_map_intelligence`)
  /// — índice espacial GiST do Map Intelligence Agent. Tipo `Unsupported`:
  /// Prisma Client não lê/escreve este campo, só existe aqui para o
  /// migration diff reconhecer a coluna; toda leitura é via
  /// `SchoolMarkerRepository` (`$queryRaw`). Nome distinto da relação
  /// `coordenadas: SchoolCoordinate[]` abaixo (histórico de tentativas de
  /// geocodificação — conceito diferente deste ponto geográfico único).
  pontoGeografico        Unsupported("geography(Point, 4326)")?

  tipos           SchoolType[]
  turnosAtendidos SchoolShift[]
  status          SchoolStatus  @default(ATIVA)

  /// De onde veio este registro (`MANUAL`, `IMPORT_CSV`, `IMPORT_EXCEL`,
  /// `IMPORT_JSON`, `SYNC_INEP`) — metadado de proveniência para
  /// triagem/auditoria, nunca usado em regra de autorização.
  origemCadastro String @default("MANUAL")

  criadoPorId String? @db.Uuid
  criadoPor   User?   @relation("SchoolCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — mesma convenção de `Company.deletedAt`/`Vehicle.deletedAt`.
  deletedAt DateTime?

  pontosAcesso           SchoolAccessPoint[]
  vinculosEmpresa        SchoolCompanyLink[]
  alunos                 Student[]
  solicitacoesTransporte TransportRequest[]
  contratos              Contract[]
  coordenadas            SchoolCoordinate[]

  @@index([status])
  @@index([cidade, estado])
  @@index([dependenciaAdministrativa])
  @@index([deletedAt])
  @@map("schools")
}

/// Portão/ponto de embarque-desembarque (briefing "PORTÕES E PONTOS DE
/// EMBARQUE" + "LOCALIZAÇÃO") — sem RLS/tenant, mesma razão de
/// `School` (é um fato físico da escola, não da empresa que o
/// cadastrou). Sem soft delete: ao contrário de Documentos/Manutenções
/// de veículo, o briefing não exige preservar histórico de portões
/// (são metadados editáveis, não um registro de evento).
model SchoolAccessPoint {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  tipo        SchoolAccessPointType @default(OUTRO)
  nome        String
  descricao   String?
  latitude    Decimal               @db.Decimal(9, 6)
  longitude   Decimal               @db.Decimal(9, 6)
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, tipo])
  @@map("school_access_points")
}

/// Vínculo Empresa<->Escola ("esta empresa atende esta escola") — ESTA
/// tabela sim tem RLS por `companyId` (ao contrário de `School`),
/// porque é o registro de negócio privado de cada tenant. Nunca
/// UPDATE/DELETE físico ao desvincular: `desvinculadoEm = now()`,
/// mesma convenção de `VehicleAssignment.encerradoEm` — preserva "esta
/// empresa já atendeu esta escola no passado" para auditoria/histórico.
/// `encerradoEm = null` é o vínculo vigente.
model SchoolCompanyLink {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @db.Uuid
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  vinculadoEm    DateTime  @default(now())
  desvinculadoEm DateTime?

  vinculadoPorId String  @db.Uuid
  vinculadoPor   User    @relation("SchoolCompanyLinkVinculadoPor", fields: [vinculadoPorId], references: [id], onDelete: Restrict)
  encerradoPorId String? @db.Uuid
  encerradoPor   User?   @relation("SchoolCompanyLinkEncerradoPor", fields: [encerradoPorId], references: [id], onDelete: SetNull)

  @@index([companyId, schoolId, desvinculadoEm])
  @@index([schoolId, desvinculadoEm])
  @@map("school_company_links")
}

// =============================================================================
// Student — Aluno (briefing "Marketplace" §"CADASTRO DO ALUNO"; Dossiê 17 `STU-*`)
// =============================================================================

/// Aluno — pertence ao RESPONSÁVEL que o cadastrou, não a uma
/// Empresa/tenant (mesma família arquitetural de `School`: sem
/// `companyId` própria, sem RLS). Decisão de escopo desta entrega: o
/// Dossiê 17 original previa o Aluno sempre cadastrado pelo
/// Gestor/Empresa ("nunca pelo Responsável"); o briefing do Marketplace
/// introduz um fluxo de autoatendimento onde o próprio Responsável
/// cadastra o aluno e SÓ DEPOIS busca um transportador — isso só é
/// coerente se o Aluno existir independentemente de qualquer empresa
/// desde o cadastro. O vínculo com um transportador específico vive em
/// `TransportRequest`/`Contract`, nunca aqui — mesmo padrão de
/// `SchoolCompanyLink` para `School`.
model Student {
  id String @id @default(uuid()) @db.Uuid

  responsavelId String @db.Uuid
  responsavel   User   @relation("StudentResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  nome           String
  fotoUrl        String?
  dataNascimento DateTime   @db.Date
  sexo           StudentSex

  schoolId String      @db.Uuid
  school   School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  turno    SchoolShift

  /// Endereço de embarque/desembarque (briefing "CADASTRO DO ALUNO")
  /// podem ser diferentes (ex. embarque em casa, desembarque na casa de
  /// um parente) — por isso duplicados em vez de um único endereço.
  embarqueCep         String
  embarqueLogradouro  String
  embarqueNumero      String
  embarqueComplemento String?
  embarqueBairro      String
  embarqueCidade      String
  embarqueEstado      String
  embarqueLatitude    Decimal? @db.Decimal(9, 6)
  embarqueLongitude   Decimal? @db.Decimal(9, 6)

  desembarqueCep         String
  desembarqueLogradouro  String
  desembarqueNumero      String
  desembarqueComplemento String?
  desembarqueBairro      String
  desembarqueCidade      String
  desembarqueEstado      String
  desembarqueLatitude    Decimal? @db.Decimal(9, 6)
  desembarqueLongitude   Decimal? @db.Decimal(9, 6)

  necessidadesEspeciais String?
  medicamentos          String?
  observacoes           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — mesma convenção de `School.deletedAt`.
  deletedAt DateTime?

  pessoasAutorizadas StudentAuthorizedPerson[]
  transportRequests  TransportRequest[]
  contracts          Contract[]
  vinculosRota       RouteStudent[]
  eventosViagem      TripStudentEvent[]

  @@index([responsavelId, deletedAt])
  @@index([schoolId])
  @@map("students")
}

/// Pessoa autorizada a buscar/acompanhar o aluno (briefing "CADASTRO DO
/// ALUNO" — campo opcional). Sem RLS/tenant, mesma razão de `Student`.
/// Sem soft delete: lista editável de metadados, não um registro de
/// evento (mesmo raciocínio de `SchoolAccessPoint`).
model StudentAuthorizedPerson {
  id        String  @id @default(uuid()) @db.Uuid
  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  nome       String
  cpf        String?
  telefone   String?
  parentesco String?

  createdAt DateTime @default(now())

  @@index([studentId])
  @@map("student_authorized_persons")
}

// =============================================================================
// Marketplace — TransportRequest, Contract, Rating (briefing "Marketplace")
// =============================================================================

/// Solicitação de transporte (briefing "SOLICITAR TRANSPORTE"/
/// "SOLICITAÇÃO") — dado de TENANT de verdade (ao contrário de
/// `Student`/`School`): representa a intenção comercial de UMA empresa
/// específica atender UM aluno específico, então tem RLS por
/// `companyId`. O Responsável (que não tem `companyId` próprio) acessa
/// as suas próprias solicitações via bypass explícito filtrado por
/// `responsavelId = actor.sub` — nunca uma consulta cross-tenant
/// arbitrária (mesmo padrão de `AuthService` resolvendo os próprios
/// `Membership`s no login, Dossiê 12 §4.6).
model TransportRequest {
  id String @id @default(uuid()) @db.Uuid

  studentId String  @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  responsavelId String @db.Uuid
  responsavel   User   @relation("TransportRequestResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  schoolId String      @db.Uuid
  school   School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  turno    SchoolShift

  status       TransportRequestStatus @default(RECEBIDA)
  motivoRecusa String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract Contract?

  @@index([companyId, status])
  @@index([responsavelId])
  @@index([studentId])
  @@map("transport_requests")
}

/// Contrato (briefing "CONTRATO") — 1:1 com a `TransportRequest`
/// aprovada. RLS por `companyId`, mesmo motivo de `TransportRequest`.
/// `authentiqueDocumentId` é o único campo já preparado para a
/// integração real com a Authentique (briefing "Preparar integração
/// com Authentique") — hoje sempre `null`, preenchido quando
/// `ContractsService` deixar de tratar a assinatura como stub.
model Contract {
  id String @id @default(uuid()) @db.Uuid

  transportRequestId String           @unique @db.Uuid
  transportRequest   TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Restrict)

  studentId     String  @db.Uuid
  student       Student @relation(fields: [studentId], references: [id], onDelete: Restrict)
  responsavelId String  @db.Uuid
  responsavel   User    @relation("ContractResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  companyId     String  @db.Uuid
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  schoolId      String  @db.Uuid
  school        School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  /// Veículo/motorista/monitor só são conhecidos quando a operação
  /// atribui um recurso concreto ao contrato — podem ficar `null` entre
  /// a ativação e essa atribuição (mesmo raciocínio de
  /// `Vehicle.ultimoMotoristaId` opcional).
  vehicleId   String?  @db.Uuid
  vehicle     Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  motoristaId String?  @db.Uuid
  motorista   User?    @relation("ContractMotorista", fields: [motoristaId], references: [id], onDelete: SetNull)
  monitorId   String?  @db.Uuid
  monitor     User?    @relation("ContractMonitor", fields: [monitorId], references: [id], onDelete: SetNull)

  valorMensalidadeCentavos Int
  planoDescricao           String
  regras                   String
  vigenciaInicio           DateTime  @db.Date
  vigenciaFim              DateTime? @db.Date

  status ContractStatus @default(AGUARDANDO_ASSINATURA)

  /// Preparado para a Authentique (sempre `null` hoje — ver nota do model).
  authentiqueDocumentId String?
  assinadoResponsavelEm DateTime?
  assinadoEmpresaEm     DateTime?
  ativadoEm             DateTime?
  encerradoEm           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings            Rating[]
  vinculoRota        RouteStudent?
  /// Créditos de mensalidade gerados na carteira Rotta Pay da empresa a
  /// partir deste contrato (Dossiê 26, Seção 6) — normalmente 1 (na
  /// ativação), mas o modelo permite mais de um (ex. reajuste futuro).
  transacoesCarteira WalletTransaction[]

  @@index([companyId, status])
  @@index([responsavelId])
  @@index([studentId])
  @@map("contracts")
}

// =============================================================================
// Rotas / GPS / Embarque / Desembarque (Dossiê 13 Seção 12, Dossiê 18)
// =============================================================================

/// Ciclo de vida estrutural da rota (briefing `ROT-01`) — `PAUSADA` até
/// ter ao menos uma parada e um aluno ativo vinculado; nunca pode virar
/// `ATIVA` sem isso (validado em `RoutesService`, não apenas na UI).
enum RouteStatus {
  ATIVA
  PAUSADA
}

/// Dias da semana em que a rota opera (briefing `ROT-04`) — lista, não
/// bitmask, para ficar legível em query/debug direto no banco.
enum RouteWeekday {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

/// Rota — o "template" recorrente que dá origem a uma `Trip` a cada dia
/// efetivamente operado (briefing `ROT-01`). RLS por `companyId`, mesmo
/// mecanismo de `Vehicle`/`School`. `motoristaPadraoId`/`veiculoPadraoId`/
/// `monitorPadraoId` são o recurso PADRÃO — a substituição pontual do dia
/// (`ROT-05`/`ROT-06`) fica registrada na `Trip` em si (`Trip.motoristaId`/
/// `veiculoId`/`monitorId`), nunca sobrescrevendo o padrão da rota.
model Route {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  nome       String
  turno      SchoolShift
  diasSemana RouteWeekday[]
  status     RouteStatus    @default(PAUSADA)

  veiculoPadraoId   String?  @db.Uuid
  veiculoPadrao     Vehicle? @relation(fields: [veiculoPadraoId], references: [id], onDelete: SetNull)
  motoristaPadraoId String?  @db.Uuid
  motoristaPadrao   User?    @relation("RouteMotoristaPadrao", fields: [motoristaPadraoId], references: [id], onDelete: SetNull)
  monitorPadraoId   String?  @db.Uuid
  monitorPadrao     User?    @relation("RouteMonitorPadrao", fields: [monitorPadraoId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete — mesma convenção de `Vehicle.deletedAt`.
  deletedAt DateTime?

  paradas RouteStop[]
  alunos  RouteStudent[]
  viagens Trip[]

  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@map("routes")
}

/// Parada física de uma rota, em ordem (briefing `ROT-07`). `companyId`
/// desnormalizado de `routeId` — mesmo raciocínio de
/// `VehicleDocument.companyId` (RLS/filtro sem precisar de join).
model RouteStop {
  id        String @id @default(uuid()) @db.Uuid
  routeId   String @db.Uuid
  route     Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  companyId String @db.Uuid

  ordem           Int
  endereco        String
  latitude        Decimal @db.Decimal(9, 6)
  longitude       Decimal @db.Decimal(9, 6)
  /// Formato "HH:mm" (mesmo padrão de `MessagePersonalizationService.veiculoProximo`) — horário previsto de passagem, nunca um `DateTime` completo (a parada se repete todo dia operado).
  horarioPrevisto String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  embarquesAqui    RouteStudent[]     @relation("RouteStudentEmbarque")
  desembarquesAqui RouteStudent[]     @relation("RouteStudentDesembarque")
  eventosAluno     TripStudentEvent[]

  @@unique([routeId, ordem])
  @@index([companyId])
  @@map("route_stops")
}

/// Vínculo aluno-rota (briefing `ROT-07`) — aponta para o `Contract`
/// (não direto para `Student`) porque só um aluno com contrato `ATIVO`
/// com ESTA empresa pode ser vinculado a uma rota DELA (o contrato já é
/// a fonte de verdade de "este aluno anda com esta empresa", Dossiê 16
/// Marketplace). `contractId` é `@unique`: um contrato tem no máximo um
/// vínculo de rota por vez — mudar de rota é atualizar `routeId` deste
/// mesmo registro, nunca criar um segundo. `RN-26` (aluno não pode estar
/// em duas rotas ativas do mesmo turno) é validada em `RoutesService`
/// via `PrismaService.withBypass` (a checagem precisa enxergar rotas de
/// QUALQUER empresa, não só a do tenant atual).
model RouteStudent {
  id        String @id @default(uuid()) @db.Uuid
  routeId   String @db.Uuid
  route     Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  companyId String @db.Uuid

  contractId String   @unique @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  studentId  String   @db.Uuid
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  paradaEmbarqueId    String    @db.Uuid
  paradaEmbarque      RouteStop @relation("RouteStudentEmbarque", fields: [paradaEmbarqueId], references: [id], onDelete: Restrict)
  paradaDesembarqueId String    @db.Uuid
  paradaDesembarque   RouteStop @relation("RouteStudentDesembarque", fields: [paradaDesembarqueId], references: [id], onDelete: Restrict)

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([studentId, ativo])
  @@map("route_students")
}

/// Ciclo de vida da execução concreta de uma rota em um dia (briefing
/// `GPS-01`/`GPS-02`). Só uma `Trip` `EM_ANDAMENTO` por rota por dia
/// (`@@unique([routeId, data])`) — impede literalmente no banco o "não é
/// possível iniciar duas vezes" de `GPS-01`.
enum TripStatus {
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
}

/// Execução concreta de uma `Route` em um dia (briefing `GPS-01`). RLS
/// por `companyId`. `motoristaId`/`veiculoId`/`monitorId` começam iguais
/// ao padrão da rota, mas podem ser substituídos pontualmente
/// (`ROT-05`/`ROT-06`) sem alterar `Route.motoristaPadraoId` — é assim
/// que o histórico preserva corretamente "quem dirigiu aquele dia
/// específico" mesmo após trocas.
model Trip {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routeId   String  @db.Uuid
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Restrict)

  /// Dia operado (não timestamp) — a chave de unicidade "uma viagem em
  /// andamento por rota por dia" (`GPS-01`) é sobre esta data, não sobre
  /// `iniciadaEm`.
  data   DateTime   @db.Date
  status TripStatus @default(EM_ANDAMENTO)

  veiculoId   String  @db.Uuid
  veiculo     Vehicle @relation("TripVeiculo", fields: [veiculoId], references: [id], onDelete: Restrict)
  motoristaId String  @db.Uuid
  motorista   User    @relation("TripMotorista", fields: [motoristaId], references: [id], onDelete: Restrict)
  monitorId   String? @db.Uuid
  monitor     User?   @relation("TripMonitor", fields: [monitorId], references: [id], onDelete: SetNull)

  iniciadaEm   DateTime  @default(now())
  finalizadaEm DateTime?
  canceladaEm  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posicoes             TripPosition[]
  eventosAluno         TripStudentEvent[]
  /// Back-relation obrigatória do Prisma para `Vehicle.viagemAtualId` — nunca usada diretamente.
  veiculosComEstaAtual Vehicle[]          @relation("VehicleViagemAtual")

  @@unique([routeId, data])
  @@index([companyId, status])
  @@map("trips")
}

/// Um "ping" de GPS dentro de uma viagem (briefing `GPS-03`/`GPS-04`/
/// `GPS-06`). `capturadaEm` é o timestamp gerado NO DISPOSITIVO (não
/// `createdAt`, que é quando o servidor recebeu) — essencial para
/// preservar a ordem real de captura quando o motorista ficou offline e
/// sincronizou um lote inteiro de uma vez (`GPS-04`). Nunca deletado nem
/// sobrescrito: mesmo uma posição de baixa precisão ou sinalizada como
/// `simuladoSuspeito` fica no histórico bruto (`GPS-06`) — a suavização/
/// descarte é só para exibição, nunca para o dado armazenado.
model TripPosition {
  id        String @id @default(uuid()) @db.Uuid
  tripId    String @db.Uuid
  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  companyId String @db.Uuid

  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  /// Precisão em metros reportada pelo próprio GPS do aparelho (`GPS-06`) — `null` quando o dispositivo não informa.
  precisaoMetros Decimal? @db.Decimal(6, 2)
  velocidadeKmh  Decimal? @db.Decimal(5, 2)
  capturadaEm    DateTime

  /// `GPS-06`: salto geograficamente incoerente com o histórico recente — sinalizado, nunca descartado. Gera alerta ao Gestor (Communication Engine), não bloqueia a viagem.
  simuladoSuspeito Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tripId, capturadaEm])
  @@index([companyId])
  @@map("trip_positions")
}

/// Checklist nominal de embarque/desembarque (briefing `EMB-01`/`EMB-05`/
/// `DESEMB-01`) — um `Evento` imutável por aluno por viagem por tipo
/// (`@@unique`), nunca uma tabela paralela de status mutável (Dossiê 8
/// §12, citado em `DESEMB-02`: "sempre parte do mesmo registro imutável
/// de Evento, nunca uma tabela paralela sujeita a divergência").
enum TripStudentEventType {
  EMBARCOU
  AUSENTE
  DESEMBARCOU
}

model TripStudentEvent {
  id        String @id @default(uuid()) @db.Uuid
  tripId    String @db.Uuid
  trip      Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  companyId String @db.Uuid

  studentId   String    @db.Uuid
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  routeStopId String    @db.Uuid
  routeStop   RouteStop @relation(fields: [routeStopId], references: [id], onDelete: Restrict)

  tipo           TripStudentEventType
  motivoAusencia String?

  processadoPorId String   @db.Uuid
  processadoPor   User     @relation("TripStudentEventProcessadoPor", fields: [processadoPorId], references: [id], onDelete: Restrict)
  processadoEm    DateTime @default(now())

  @@unique([tripId, studentId, tipo])
  @@index([tripId])
  @@index([studentId])
  @@map("trip_student_events")
}

/// Avaliação (briefing "AVALIAÇÕES") — `alvoId` é polimórfico
/// (Motorista/Monitor => `User.id`; Empresa => `Company.id`; Veículo =>
/// `Vehicle.id`), sem FK nativa, mesmo trade-off já documentado em
/// `AuditLog.entidadeId` (perde-se integridade referencial forte em
/// troca de um único modelo cobrindo os 4 alvos possíveis em vez de 4
/// tabelas quase idênticas). RLS por `companyId` (o contrato de origem
/// já é de um tenant específico).
model Rating {
  id String @id @default(uuid()) @db.Uuid

  contractId String   @db.Uuid
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  responsavelId String  @db.Uuid
  responsavel   User    @relation("RatingResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  companyId     String  @db.Uuid
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  alvoTipo RatingTargetType
  alvoId   String           @db.Uuid

  nota       Int
  comentario String?

  createdAt DateTime @default(now())

  @@unique([contractId, responsavelId, alvoTipo, alvoId])
  @@index([companyId])
  @@index([alvoTipo, alvoId])
  @@map("ratings")
}

// =============================================================================
// Rotta Communication Engine — Notification, DeviceToken, NotificationPreference,
// NotificationDeliveryAttempt (módulo Communication — "toda comunicação da
// plataforma deverá passar exclusivamente por esse módulo")
// =============================================================================

/// Canal de envio suportado hoje pelo Communication Engine — arquitetura
/// preparada para novos canais (novo valor de enum + novo `ChannelSender`,
/// nunca uma reescrita dos modelos abaixo).
enum CommunicationChannel {
  PUSH
  WHATSAPP
  SMS
  EMAIL
  IN_APP
}

/// Evento de origem de uma notificação (briefing "EVENTOS") — cada valor é
/// disparado por exatamente um módulo via `@nestjs/event-emitter`; nenhum
/// módulo além do Communication Engine decide o(s) canal(is) finais.
enum NotificationEventType {
  VIAGEM_INICIADA
  VIAGEM_ENCERRADA
  ALUNO_EMBARCOU
  ALUNO_DESEMBARCOU
  ALUNO_AUSENTE
  VEICULO_PROXIMO
  MOTORISTA_ALTERADO
  MONITOR_ALTERADO
  VEICULO_ALTERADO
  ROTA_ALTERADA
  OCORRENCIA
  EMERGENCIA
  NOVO_CONTRATO
  CONTRATO_ASSINADO
  CNH_VENCENDO
  DOCUMENTO_VENCENDO
  PAGAMENTO_APROVADO
  PAGAMENTO_RECUSADO
  PAGAMENTO_PENDENTE
  NOVA_ESCOLA
  NOVO_ALUNO
  NOVO_RESPONSAVEL
}

/// Nível de prioridade (briefing "AGENTE 02 — Notification Priority AI") —
/// `EMERGENCIA` é o único nível que ignora Quiet Hours (briefing "QUIET
/// HOURS", "Exceto notificações críticas").
enum NotificationPriority {
  INFORMATIVA
  IMPORTANTE
  URGENTE
  CRITICA
  EMERGENCIA
}

/// Status de uma tentativa de entrega em UM canal (briefing "AGENTE 03 —
/// Delivery AI") — não confundir com `Notification.lida`, que é o estado de
/// leitura do item na Central de Notificações (canal `IN_APP` implícito).
enum NotificationDeliveryStatus {
  PENDENTE
  ENFILEIRADA
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

/// Plataforma de um Token FCM (briefing "PUSH NOTIFICATION" —
/// "Compatível com Android/iOS/Web").
enum DeviceTokenPlatform {
  ANDROID
  IOS
  WEB
}

/// Item da Central de Notificações Internas (briefing "NOTIFICAÇÕES
/// INTERNAS" — "Cada usuário possui seu próprio histórico"). Sempre
/// pertence a UM `User` (qualquer papel, inclusive Responsável e Admin
/// Rotta); `companyId` é OPCIONAL — presente apenas quando a notificação
/// se origina de um contexto de tenant (para alimentar o dashboard de
/// comunicação da empresa), nulo para notificações puramente pessoais/
/// globais. RLS: acesso ao próprio inbox é SEMPRE via bypass explícito
/// filtrado por `userId = actor.sub` na camada de aplicação (nunca uma
/// policy de RLS por `userId` — mesmo raciocínio do bypass de
/// Responsável documentado em `TransportRequest`, generalizado aqui para
/// todo usuário, já que um inbox de notificações é sempre pessoal); a
/// policy de RLS por `companyId` abaixo cobre apenas a consulta agregada
/// do dashboard da empresa.
model Notification {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Presente apenas quando originada em um contexto de tenant (ver nota
  /// do model) — nunca usado para restringir o acesso do destinatário ao
  /// próprio item, somente para o dashboard agregado da empresa.
  companyId String?  @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tipo       NotificationEventType
  prioridade NotificationPriority  @default(INFORMATIVA)

  /// Título/corpo já resolvidos pelo Message Personalization AI (briefing
  /// "AGENTE 04") — nunca um texto genérico quando havia dado disponível.
  titulo String
  corpo  String

  /// Dados estruturados para personalização/deep-link (ex. `tripId`,
  /// `studentId`, ETA) — nunca dado pessoal sensível além do
  /// indispensável para o próprio destinatário abrir o item (LGPD,
  /// briefing "SEGURANÇA").
  dadosContexto Json?

  /// Canais efetivamente escolhidos pela Communication AI (briefing
  /// "ROTTA COMMUNICATION AI") para este evento — o detalhe por canal
  /// (entregue/falhou/lido/tempo de resposta) fica em
  /// `NotificationDeliveryAttempt`, nunca duplicado aqui.
  canaisEscolhidos CommunicationChannel[]

  lida   Boolean   @default(false)
  lidaEm DateTime?

  favoritada Boolean @default(false)
  arquivada  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tentativasEntrega NotificationDeliveryAttempt[]

  @@index([userId, arquivada, lida, createdAt])
  @@index([userId, favoritada])
  @@index([companyId, createdAt])
  @@map("notifications")
}

/// Tentativa de entrega de UMA `Notification` em UM canal (briefing
/// "AGENTE 03 — Delivery AI" e "CENTRAL DE COMUNICAÇÃO"/"LOGS") — cada
/// reenvio automático ou troca de canal gera uma nova linha (nunca
/// sobrescreve a anterior), preservando o histórico completo exigido por
/// "LOGS: Registrar absolutamente tudo".
model NotificationDeliveryAttempt {
  id String @id @default(uuid()) @db.Uuid

  notificationId String       @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  canal     CommunicationChannel
  status    NotificationDeliveryStatus @default(PENDENTE)
  tentativa Int                        @default(1)

  /// Nome do provedor real que processou o envio (ex. `"fcm"`,
  /// `"twilio"`, `"meta-whatsapp-cloud-api"`) — `null` enquanto o canal
  /// ainda é um stub honesto sem provedor contratado (briefing WhatsApp/
  /// SMS).
  provedor String?
  erro     String?

  enviadoEm       DateTime?
  entregueEm      DateTime?
  lidaEm          DateTime?
  tempoRespostaMs Int?

  createdAt DateTime @default(now())

  @@index([notificationId, canal])
  @@index([status, createdAt])
  @@map("notification_delivery_attempts")
}

/// Token FCM de um dispositivo (briefing "PUSH NOTIFICATION" — "Cada
/// dispositivo deverá possuir um Token FCM único. Implementar renovação
/// automática do token"). Um `User` pode ter vários dispositivos ativos
/// simultaneamente (celular + web, por exemplo); `token` é único porque
/// o FCM nunca emite o mesmo token para dois registros distintos.
model DeviceToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String              @unique
  plataforma DeviceTokenPlatform

  /// `false` quando o token expirou e ainda não foi renovado pelo
  /// próprio dispositivo (briefing — "se expirar, gerar novo
  /// automaticamente") ou quando o FCM devolveu erro definitivo
  /// (desinstalado) — inativos nunca recebem novo envio.
  ativo       Boolean  @default(true)
  ultimoUsoEm DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, ativo])
  @@map("device_tokens")
}

/// Preferências de comunicação de UM usuário (briefing
/// "CONFIGURAÇÕES"/"QUIET HOURS") — camada aplicada POR CIMA de
/// `CompanySetting.canaisNotificacao` (canal efetivo = habilitado pela
/// empresa E habilitado pelo usuário); nunca duplica a configuração da
/// empresa, apenas restringe.
model NotificationPreference {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  receberPush     Boolean @default(true)
  receberWhatsapp Boolean @default(true)
  receberSms      Boolean @default(true)
  receberEmail    Boolean @default(true)

  silenciarFinsDeSemana Boolean @default(false)

  /// Horário silencioso diário (briefing "ex. 22:00 até 06:00") — formato
  /// `"HH:mm"`; `null` em ambos desativa o Quiet Hours. Nunca aplicado a
  /// `NotificationPriority.EMERGENCIA` (briefing — "Exceto notificações
  /// críticas").
  quietHoursInicio String?
  quietHoursFim    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

// =============================================================================
// Rotta Pay — Carteira e Pagamentos (Dossiê 26)
// =============================================================================

/// Dono da carteira — polimórfico por duas FKs opcionais e únicas
/// (nunca as duas preenchidas ao mesmo tempo; validado em
/// `WalletService`, não no banco) em vez de uma FK genérica
/// `entidadeId`/`entidadeTipo` (padrão de `AuditLog`) porque aqui
/// QUEREMOS a integridade referencial forte do Postgres — é dinheiro.
enum WalletOwnerType {
  EMPRESA
  MOTORISTA
}

/// Tipo da movimentação no ledger (Dossiê 26, Seção 3) — o sinal
/// (crédito/débito) vem do prefixo, nunca de um campo `sinal` solto.
enum WalletTransactionType {
  CREDITO_MENSALIDADE
  CREDITO_AJUSTE
  /// Devolução ao saldo disponível de um `DEBITO_SAQUE` cujo saque foi
  /// rejeitado (Dossiê 26, Seção 3) — nunca edita a linha original,
  /// sempre uma nova linha.
  CREDITO_ESTORNO
  DEBITO_SAQUE
  DEBITO_TARIFA
  DEBITO_AJUSTE
}

/// `PENDENTE` = aguardando confirmação (mensalidade a receber, saque em
/// processamento) — nunca compõe `saldoDisponivelCentavos` enquanto
/// nesse estado (ver `Wallet` e Dossiê 26, Seção 3).
enum WalletTransactionStatus {
  PENDENTE
  CONCLUIDA
  FALHOU
}

enum WithdrawalRequestStatus {
  SOLICITADO
  EM_PROCESSAMENTO
  CONCLUIDO
  REJEITADO
}

/// Carteira Rotta Pay (Dossiê 26) — uma por Empresa OU uma por
/// Motorista, criada sob demanda na primeira movimentação
/// (`WalletService.getOrCreate`). `saldoDisponivelCentavos` é o único
/// valor sacável; `saldoPendenteCentavos` é dinheiro "a receber" (ainda
/// não confirmado por ninguém) e NUNCA pode ser sacado.
model Wallet {
  id String @id @default(uuid()) @db.Uuid

  ownerType WalletOwnerType

  companyId String?  @unique @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  motoristaId String? @unique @db.Uuid
  motorista   User?   @relation(fields: [motoristaId], references: [id], onDelete: Cascade)

  saldoDisponivelCentavos Int    @default(0)
  saldoPendenteCentavos   Int    @default(0)
  moeda                   String @default("BRL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]

  @@index([ownerType])
  @@map("wallets")
}

/// Ledger append-only (Dossiê 26, Seção 3) — nunca UPDATE/DELETE via
/// aplicação (mesmo princípio de `AuditLog`); uma correção é sempre uma
/// NOVA linha (`CREDITO_AJUSTE`/`DEBITO_ESTORNO`), nunca editar uma
/// existente. `saldoDisponivelAposCentavos` é o snapshot do saldo
/// disponível logo após esta transação — permite auditar/reconstruir o
/// histórico linha a linha sem depender só do valor atual em `Wallet`.
model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  tipo   WalletTransactionType
  status WalletTransactionStatus @default(CONCLUIDA)

  /// Sempre positivo — o sinal (crédito/débito) vem de `tipo`.
  valorCentavos               Int
  saldoDisponivelAposCentavos Int
  descricao                   String

  /// Presente quando esta transação veio de uma mensalidade de contrato
  /// ativado (Dossiê 26, Seção 6) — `SetNull` porque o `Contract` pode,
  /// em tese, ser removido por retenção de dados muito depois de o
  /// ledger financeiro já existir; o registro financeiro nunca pode
  /// sumir por causa disso.
  contractId String?   @db.Uuid
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  withdrawalRequestId String?            @unique @db.Uuid
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)

  /// `null` = evento automático do sistema (ex. crédito de mensalidade
  /// na ativação do contrato); preenchido quando um humano agiu (Admin
  /// Rotta confirmando um crédito pendente, por exemplo).
  criadaPorUserId String? @db.Uuid
  criadaPor       User?   @relation("WalletTransactionCriadaPor", fields: [criadaPorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
  @@index([contractId])
  @@map("wallet_transactions")
}

/// Solicitação de saque (Dossiê 26, Seção 3) — o valor já é debitado do
/// `saldoDisponivelCentavos` da carteira no momento da solicitação (via
/// a `WalletTransaction` vinculada, status `PENDENTE`), nunca só na
/// conclusão — evita saque em dobro enquanto aguarda o provedor
/// (`RottaPayProviderService`, stub honesto, Dossiê 26 Seção 4).
model WithdrawalRequest {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  valorCentavos Int
  /// Chave PIX — padrão brasileiro de dado bancário, mais simples que
  /// agência/conta (Dossiê 26, Seção 3).
  chavePix      String
  status        WithdrawalRequestStatus @default(SOLICITADO)

  solicitadoPorUserId String @db.Uuid
  solicitadoPor       User   @relation("WithdrawalRequestSolicitadoPor", fields: [solicitadoPorUserId], references: [id], onDelete: Restrict)

  /// Id da transferência no provedor de pagamento parceiro real —
  /// sempre `null` hoje (stub honesto, Dossiê 26 Seção 4).
  providerReferencia String?
  motivoRejeicao     String?
  processadoEm       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaction WalletTransaction?

  @@index([walletId, status])
  @@map("withdrawal_requests")
}
