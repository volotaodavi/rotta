// Schema Prisma da Rotta — Dossie 8 (modelagem de dados) e Dossie 12 (Secao 6).
//
// ESTADO ATUAL: apenas a infraestrutura (datasource + generator). Nenhuma
// tabela/model foi criada ainda — isso acontece quando o primeiro modulo
// de dominio real for implementado, seguindo rigorosamente o modelo
// conceitual do Dossie 8 (entidades, relacionamentos, indices,
// particionamento da tabela PosicaoGPS, Row-Level Security por tenant).
//
// Extensoes previstas quando o schema real for criado (Dossie 8, Secao 22):
//   - PostGIS (geolocalizacao de paradas, geofencing)
//   - Particionamento declarativo nativo do Postgres (tabela PosicaoGPS)
//
// generator client {
//   provider        = "prisma-client-js"
//   previewFeatures = ["postgresqlExtensions"]
// }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // extensions = [postgis] — habilitado junto com o primeiro model geoespacial (Dossie 8, Secao 16.1)
}
