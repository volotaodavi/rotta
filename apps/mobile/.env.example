# Ver Dossie 23, Secao 8. Apenas variaveis EXPO_PUBLIC_* chegam ao
# bundle do cliente — nenhum segredo real deve viver aqui.
EXPO_PUBLIC_API_URL="http://localhost:3333/v1"
# URL do Site/Painel Web (Dossie 15, AUTH-01) — usada para abrir "Criar
# Empresa" em WebView integrada, nunca em navegador externo. Em producao,
# aponta para o dominio real (https://SEU-DOMINIO.com.br).
EXPO_PUBLIC_WEB_URL="http://localhost:3000"
# Token PUBLICO do Mapbox (pk.*, nunca sk.*) — Rotta Geo Platform.
# Opcional: sem ele, as telas de mapa caem no fallback de lista.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# Token de DOWNLOAD do Mapbox (secreto, sk.* com escopo DOWNLOADS:READ,
# NAO prefixado EXPO_PUBLIC_ — nunca chega ao bundle do cliente) — só
# necessario para instalar dependencias/gerar um build nativo local
# (config plugin @rnmapbox/maps). Obtido em account.mapbox.com/access-tokens.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=""
