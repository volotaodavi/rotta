{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.22.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3333/v1",
        "EXPO_PUBLIC_WEB_URL": "http://localhost:3000",
        "EXPO_PUBLIC_MAPTILER_API_KEY": "j94bZRdWHQSJbCtQR06w"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.22.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rotta-vt7i.onrender.com/v1",
        "EXPO_PUBLIC_WEB_URL": "https://rotta-web.vercel.app",
        "EXPO_PUBLIC_MAPTILER_API_KEY": "j94bZRdWHQSJbCtQR06w"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "node": "22.22.2",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rotta-vt7i.onrender.com/v1",
        "EXPO_PUBLIC_WEB_URL": "https://rotta-web.vercel.app",
        "EXPO_PUBLIC_MAPTILER_API_KEY": "j94bZRdWHQSJbCtQR06w"
      },
      "ios": {}
    }
  },
  "submit": {
    "interno": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    },
    "alpha": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "alpha"
      }
    },
    "beta": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "beta"
      }
    },
    "producao": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
