{
  "name": "@rotta/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App mobile da Rotta (Motorista, Monitor, Responsavel) — React Native + Expo (Dossie 9 e Dossie 22, Secao 4.2). Um unico codigo-fonte, publicado como dois produtos de loja (Dossie 9, Secao 4.2.1).",
  "license": "UNLICENSED",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "dev:driver": "EXPO_PUBLIC_APP_VARIANT=driver expo start",
    "dev:parent": "EXPO_PUBLIC_APP_VARIANT=parent expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "echo \"[@rotta/mobile] build de producao via EAS — ver Dossie 9, Secao 6.1\" && exit 0",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "echo \"[@rotta/mobile] nenhum teste ainda — ver Dossie 23, Secao 10\" && exit 0",
    "test:e2e": "echo \"[@rotta/mobile] Detox/Maestro sera configurado junto com o primeiro fluxo real\" && exit 0",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.1.14",
    "@react-navigation/bottom-tabs": "^7.1.3",
    "@rotta/api-client": "workspace:*",
    "@rotta/auth": "workspace:*",
    "@rotta/notifications": "workspace:*",
    "@rotta/storage": "workspace:*",
    "@rotta/theme": "workspace:*",
    "@rotta/types": "workspace:*",
    "@rotta/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.11",
    "expo": "~52.0.23",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@rotta/config": "workspace:*",
    "babel-preset-expo": "~12.0.0",
    "@types/react": "^18.3.17",
    "eslint": "^8.57.1",
    "typescript": "^5.7.2"
  }
