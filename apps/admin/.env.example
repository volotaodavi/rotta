# Ver Dossie 23, Secao 8. Nenhum valor aqui e um segredo real.
NEXT_PUBLIC_API_URL="http://localhost:3333/v1"
# Rotta Geo Platform: mapas via MapLibre GL JS. Sem esta variavel, usa a
# OpenFreeMap gratuita (sem chave nenhuma). Com ela, usa a MapTiler
# (mais estavel em producao) — mesma chave de apps/web/.env.example.
NEXT_PUBLIC_MAPTILER_API_KEY=""

# Opcional — link "Entrar no Painel Web" na tela /entrar quando a conta
# nao e Admin Rotta (src/lib/site-config.ts, getWebUrl()). Sem esta
# variavel, o app usa "http://localhost:3000" em dev e
# "https://rotta-web.vercel.app" (URL real de producao) em build de
# producao.
NEXT_PUBLIC_WEB_URL=""
